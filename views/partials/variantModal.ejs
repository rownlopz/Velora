<!-- Reusable Variant Selection Modal -->
<div id="variantModalOverlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 transition-opacity duration-200 opacity-0"
     role="dialog" aria-modal="true" aria-labelledby="variantModalTitle">
    <div id="variantModalContainer" class="bg-white rounded-2xl max-w-md w-full overflow-hidden shadow-2xl transform transition-all duration-200 scale-95 relative max-h-[90vh] flex flex-col">
        
        <!-- Header with Close Button -->
        <div class="p-5 pb-3 border-b border-gray-100 flex items-start justify-between">
            <div class="flex items-center gap-3 pr-2">
                <img id="variantModalImg" src="" alt="Product" class="w-14 h-16 object-cover rounded-lg bg-gray-50 border border-gray-100 shrink-0">
                <div>
                    <h3 id="variantModalTitle" class="text-base font-medium text-gray-900 leading-snug line-clamp-1"></h3>
                    <p id="variantModalBrand" class="text-xs text-gray-400 mt-0.5"></p>
                    <p id="variantModalPrice" class="text-sm font-semibold text-gray-900 mt-1"></p>
                </div>
            </div>
            <button type="button" id="closeVariantModalBtn" 
                class="w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:text-black hover:bg-gray-100 transition shrink-0"
                aria-label="Close modal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Body / Options -->
        <div class="p-5 overflow-y-auto space-y-4 flex-1">
            <!-- Size Selection -->
            <div id="variantSizeSection">
                <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Select Size</label>
                <div id="variantSizeOptions" class="flex flex-wrap gap-2">
                    <!-- Populated by JS -->
                </div>
            </div>

            <!-- Color Selection -->
            <div id="variantColorSection">
                <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Select Color</label>
                <div id="variantColorOptions" class="flex flex-wrap gap-2">
                    <!-- Populated by JS -->
                </div>
            </div>

            <!-- Stock Status Message -->
            <div class="pt-1">
                <p id="variantStockStatus" class="text-xs font-medium text-gray-500"></p>
            </div>

            <!-- Quantity Selector -->
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Quantity</label>
                <div class="flex items-center border border-gray-200 rounded-lg w-32 h-10 bg-gray-50">
                    <button type="button" id="variantQtyMinus" class="w-10 h-full flex items-center justify-center text-gray-600 hover:text-black hover:bg-gray-100 rounded-l-lg transition">&minus;</button>
                    <input type="number" id="variantQtyInput" value="1" min="1" max="5" readonly class="w-12 h-full text-center bg-transparent text-sm font-semibold text-gray-900 outline-none">
                    <button type="button" id="variantQtyPlus" class="w-10 h-full flex items-center justify-center text-gray-600 hover:text-black hover:bg-gray-100 rounded-r-lg transition">&plus;</button>
                </div>
            </div>
        </div>

        <!-- Footer / Action -->
        <div class="p-5 pt-3 border-t border-gray-100 bg-gray-50/50">
            <button type="button" id="variantConfirmBtn"
                class="w-full h-12 bg-black text-white text-xs font-semibold uppercase tracking-widest rounded-xl hover:bg-gray-800 active:scale-[0.99] transition flex items-center justify-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed">
                <span>Add to Cart</span>
            </button>
        </div>

    </div>
</div>

<script>
(function() {
    let _variants = [];
    let _product = null;
    let _selectedSize = null;
    let _selectedColor = null;
    let _selectedVariant = null;
    let _quantity = 1;
    let _sourceVariantId = null;
    let _onSuccessCallback = null;
    let _triggerElement = null;

    const overlay = document.getElementById('variantModalOverlay');
    const container = document.getElementById('variantModalContainer');
    const closeBtn = document.getElementById('closeVariantModalBtn');
    const imgEl = document.getElementById('variantModalImg');
    const titleEl = document.getElementById('variantModalTitle');
    const brandEl = document.getElementById('variantModalBrand');
    const priceEl = document.getElementById('variantModalPrice');
    const sizeOptionsEl = document.getElementById('variantSizeOptions');
    const colorOptionsEl = document.getElementById('variantColorOptions');
    const stockStatusEl = document.getElementById('variantStockStatus');
    const qtyInput = document.getElementById('variantQtyInput');
    const qtyMinus = document.getElementById('variantQtyMinus');
    const qtyPlus = document.getElementById('variantQtyPlus');
    const confirmBtn = document.getElementById('variantConfirmBtn');

    function openModal() {
        _triggerElement = document.activeElement;
        overlay.classList.remove('hidden');
        requestAnimationFrame(() => {
            overlay.classList.remove('opacity-0');
            container.classList.remove('scale-95');
            container.classList.add('scale-100');
        });
        document.body.style.overflow = 'hidden';
        setTimeout(() => {
            const firstBtn = sizeOptionsEl.querySelector('button') || confirmBtn;
            if (firstBtn) firstBtn.focus();
        }, 100);
    }

    function closeModal() {
        overlay.classList.add('opacity-0');
        container.classList.remove('scale-100');
        container.classList.add('scale-95');
        setTimeout(() => {
            overlay.classList.add('hidden');
            document.body.style.overflow = '';
            if (_triggerElement && typeof _triggerElement.focus === 'function') {
                _triggerElement.focus();
            }
        }, 200);
    }

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeModal();
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
            closeModal();
        }
    });

    function updateSelectedVariant() {
        _selectedVariant = _variants.find(v => 
            v.size === _selectedSize && 
            (v.color || '').toLowerCase() === (_selectedColor || '').toLowerCase()
        ) || null;

        if (_selectedVariant) {
            const displayPrice = _selectedVariant.displayPrice != null 
                ? _selectedVariant.displayPrice 
                : (_selectedVariant.salePrice != null ? _selectedVariant.salePrice : _selectedVariant.regularPrice);
            priceEl.innerHTML = '&#8377;' + Number(displayPrice).toLocaleString('en-IN');

            const stock = _selectedVariant.stock || 0;
            if (stock <= 0) {
                stockStatusEl.textContent = 'Out of Stock';
                stockStatusEl.className = 'text-xs font-semibold text-rose-600';
                confirmBtn.disabled = true;
                confirmBtn.textContent = 'Out of Stock';
            } else {
                if (stock <= 3) {
                    stockStatusEl.textContent = `Only ${stock} left in stock!`;
                    stockStatusEl.className = 'text-xs font-semibold text-amber-600';
                } else {
                    stockStatusEl.textContent = `In Stock (${stock} available)`;
                    stockStatusEl.className = 'text-xs font-medium text-emerald-600';
                }
                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Add to Cart';
            }

            // Cap quantity if exceeds stock
            const maxAllowed = Math.min(stock, 5);
            if (_quantity > maxAllowed && maxAllowed > 0) {
                _quantity = maxAllowed;
                qtyInput.value = _quantity;
            }
        } else {
            priceEl.textContent = '—';
            stockStatusEl.textContent = 'Please choose size & color';
            stockStatusEl.className = 'text-xs text-gray-500';
            confirmBtn.disabled = true;
        }
    }

    function renderOptions() {
        const uniqueSizes = [...new Set(_variants.map(v => v.size).filter(Boolean))];
        const uniqueColors = [...new Set(_variants.map(v => v.color).filter(Boolean))];

        // Sizes
        sizeOptionsEl.innerHTML = '';
        uniqueSizes.forEach(size => {
            const hasStock = _variants.some(v => v.size === size && v.stock > 0);
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = size;
            btn.className = `min-w-[40px] h-9 px-3 rounded-lg border text-xs font-medium transition ${
                size === _selectedSize 
                    ? 'border-black bg-black text-white font-semibold' 
                    : hasStock 
                        ? 'border-gray-200 bg-white text-gray-800 hover:border-black' 
                        : 'border-gray-200 bg-gray-50 text-gray-300 line-through'
            }`;
            btn.onclick = () => {
                _selectedSize = size;
                renderOptions();
                updateSelectedVariant();
            };
            sizeOptionsEl.appendChild(btn);
        });

        // Colors
        colorOptionsEl.innerHTML = '';
        uniqueColors.forEach(color => {
            const matchForSize = _variants.find(v => v.size === _selectedSize && (v.color || '').toLowerCase() === color.toLowerCase());
            const hasStock = matchForSize && matchForSize.stock > 0;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = color;
            btn.className = `h-9 px-3.5 rounded-lg border text-xs font-medium transition ${
                color === _selectedColor 
                    ? 'border-black bg-black text-white font-semibold' 
                    : hasStock 
                        ? 'border-gray-200 bg-white text-gray-800 hover:border-black' 
                        : 'border-gray-200 bg-gray-50 text-gray-300'
            }`;
            btn.onclick = () => {
                _selectedColor = color;
                renderOptions();
                updateSelectedVariant();
            };
            colorOptionsEl.appendChild(btn);
        });

        document.getElementById('variantSizeSection').style.display = uniqueSizes.length > 0 ? 'block' : 'none';
        document.getElementById('variantColorSection').style.display = uniqueColors.length > 0 ? 'block' : 'none';
    }

    qtyMinus.addEventListener('click', () => {
        if (_quantity > 1) {
            _quantity--;
            qtyInput.value = _quantity;
        }
    });

    qtyPlus.addEventListener('click', () => {
        const stock = _selectedVariant ? _selectedVariant.stock : 5;
        const maxLimit = Math.min(stock, 5);
        if (_quantity < maxLimit) {
            _quantity++;
            qtyInput.value = _quantity;
        } else if (_selectedVariant && _quantity >= stock) {
            if (typeof window.showToast === 'function') window.showToast(`Only ${stock} available in stock.`, 'info');
        }
    });

    confirmBtn.addEventListener('click', async () => {
        if (!_selectedVariant || confirmBtn.disabled) return;
        confirmBtn.disabled = true;
        const originalText = confirmBtn.textContent;
        confirmBtn.textContent = 'Adding...';

        try {
            const res = await fetch('/cart/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify({
                    variantId: _selectedVariant._id,
                    quantity: _quantity,
                    sourceVariantId: _sourceVariantId || null,
                }),
            });

            if (res.status === 401) {
                window.location.href = '/login';
                return;
            }

            const data = await res.json();
            if (data.requireLogin) {
                window.location.href = '/login';
                return;
            }

            if (data.success) {
                if (typeof window.updateNavCartCount === 'function' && typeof data.cartCount === 'number') {
                    window.updateNavCartCount(data.cartCount);
                }
                if (typeof window.updateNavWishlistCount === 'function' && typeof data.wishlistCount === 'number') {
                    window.updateNavWishlistCount(data.wishlistCount);
                }
                if (typeof window.showToast === 'function') {
                    window.showToast('Added to bag', 'success');
                }
                closeModal();
                if (typeof _onSuccessCallback === 'function') {
                    _onSuccessCallback(data, _selectedVariant, _sourceVariantId);
                }
            } else {
                if (typeof window.showToast === 'function') {
                    window.showToast(data.message || 'Unable to add to cart', 'error');
                }
                confirmBtn.disabled = false;
                confirmBtn.textContent = originalText;
            }
        } catch (err) {
            console.error('Cart add error:', err);
            if (typeof window.showToast === 'function') {
                window.showToast('Something went wrong. Please try again.', 'error');
            }
            confirmBtn.disabled = false;
            confirmBtn.textContent = originalText;
        }
    });

    /**
     * Public API: window.openVariantSelectionModal
     */
    window.openVariantSelectionModal = async function({ slug, sourceVariantId = null, preselectedVariantId = null, onSuccess = null }) {
        _sourceVariantId = sourceVariantId;
        _onSuccessCallback = onSuccess;
        _quantity = 1;
        qtyInput.value = 1;

        try {
            const res = await fetch(`/products/${encodeURIComponent(slug)}/variants`, {
                headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!res.ok) {
                if (typeof window.showToast === 'function') window.showToast('Could not load product options.', 'error');
                return;
            }
            const data = await res.json();
            if (!data.success || !data.variants || data.variants.length === 0) {
                if (typeof window.showToast === 'function') window.showToast('No available options for this product.', 'info');
                return;
            }

            _product = data.product;
            _variants = data.variants;

            titleEl.textContent = _product.name;
            brandEl.textContent = _product.brand || '';
            imgEl.src = _product.thumbnail || (_variants[0] && _variants[0].images && _variants[0].images[0]) || '';

            // Pre-select variant if provided or choose first available with stock
            let initial = null;
            if (preselectedVariantId) {
                initial = _variants.find(v => v._id.toString() === preselectedVariantId.toString());
            }
            if (!initial) {
                initial = _variants.find(v => v.stock > 0) || _variants[0];
            }

            _selectedSize = initial ? initial.size : (_variants[0] ? _variants[0].size : null);
            _selectedColor = initial ? initial.color : (_variants[0] ? _variants[0].color : null);

            renderOptions();
            updateSelectedVariant();
            openModal();
        } catch (err) {
            console.error('Failed to open variant modal:', err);
            if (typeof window.showToast === 'function') window.showToast('Unable to open product options.', 'error');
        }
    };
})();
</script>
