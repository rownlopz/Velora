<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Coupon Management | VELORA Admin' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#FAFAF8]">

    <div class="flex">

        <%- include("partials/sidebar", { active: "coupons" }) %>

        <div class="flex-1 min-w-0">

            <%- include("partials/topbar") %>

            <main class="px-8 py-8 max-w-7xl">

                <div class="flex justify-between items-start mb-8">
                    <div>
                        <p class="text-xs text-gray-400 uppercase tracking-widest mb-1">Admin / Marketing</p>
                        <h1 class="text-3xl font-bold text-gray-900">Coupon Management</h1>
                        <p class="text-gray-500 mt-1">Create and manage discount promo codes for customer checkout.</p>
                    </div>

                    <button type="button" onclick="openCouponModal()"
                        class="h-11 px-5 inline-flex items-center gap-2 bg-black text-white rounded-lg text-sm font-semibold hover:bg-gray-800 transition">
                        + Create Coupon
                    </button>
                </div>

                <!-- Search & Status Filter -->
                <div class="bg-white p-5 rounded-xl border border-gray-200 mb-6 flex flex-wrap items-center justify-between gap-4">
                    <form action="/admin/coupons" method="GET" class="flex flex-wrap items-center gap-3">
                        <input type="text" name="search" value="<%= search %>" placeholder="Search by coupon code..."
                            class="h-10 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none w-64 uppercase">

                        <select name="status" class="h-10 px-3 border border-gray-300 rounded-lg text-sm bg-white outline-none">
                            <option value="ALL" <%= status === 'ALL' ? 'selected' : '' %>>All Statuses</option>
                            <option value="ACTIVE" <%= status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
                            <option value="INACTIVE" <%= status === 'INACTIVE' ? 'selected' : '' %>>Inactive</option>
                        </select>

                        <button type="submit" class="h-10 px-5 bg-black text-white rounded-lg text-sm font-semibold">Filter</button>
                        <% if (search || status !== 'ALL') { %>
                            <a href="/admin/coupons" class="text-xs text-gray-500 hover:text-black underline ml-2">Clear</a>
                        <% } %>
                    </form>

                    <p class="text-xs text-gray-400 font-medium">Total: <%= totalCoupons %> coupons</p>
                </div>

                <!-- Coupons Table -->
                <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-400 uppercase tracking-widest text-left">
                                <tr>
                                    <th class="px-6 py-4 font-medium">Code</th>
                                    <th class="px-6 py-4 font-medium">Discount</th>
                                    <th class="px-6 py-4 font-medium">Min Spend</th>
                                    <th class="px-6 py-4 font-medium">Usage</th>
                                    <th class="px-6 py-4 font-medium">Per User</th>
                                    <th class="px-6 py-4 font-medium">Validity</th>
                                    <th class="px-6 py-4 font-medium">Status</th>
                                    <th class="px-6 py-4 font-medium text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                <% if (!coupons || coupons.length === 0) { %>
                                    <tr>
                                        <td colspan="8" class="px-6 py-12 text-center text-gray-400 text-sm">No coupons created yet.</td>
                                    </tr>
                                <% } else { %>
                                    <% coupons.forEach((cpn) => { %>
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-6 py-4 font-mono font-bold text-gray-900 tracking-wider">
                                                <%= cpn.code %>
                                                <% if (cpn.description) { %>
                                                    <p class="font-sans font-normal text-xs text-gray-400"><%= cpn.description %></p>
                                                <% } %>
                                            </td>
                                            <td class="px-6 py-4 font-semibold text-gray-900">
                                                <%= cpn.discountType === 'PERCENTAGE' ? cpn.discountValue + '%' : '₹' + cpn.discountValue %>
                                                <% if (cpn.maxDiscount) { %>
                                                    <span class="text-[11px] text-gray-400 font-normal">(Cap: ₹<%= cpn.maxDiscount %>)</span>
                                                <% } %>
                                            </td>
                                            <td class="px-6 py-4 text-gray-600">&#8377;<%= cpn.minPurchase.toLocaleString('en-IN') %></td>
                                            <td class="px-6 py-4 text-gray-700">
                                                <%= cpn.usedCount %> / <%= cpn.usageLimit != null ? cpn.usageLimit : '∞' %>
                                            </td>
                                            <td class="px-6 py-4 text-gray-700"><%= cpn.perUserLimit %> max</td>
                                            <td class="px-6 py-4 text-xs text-gray-600">
                                                <%= new Date(cpn.startDate).toLocaleDateString('en-IN') %> &ndash; <%= new Date(cpn.endDate).toLocaleDateString('en-IN') %>
                                            </td>
                                            <td class="px-6 py-4">
                                                <form action="/admin/coupons/<%= cpn._id %>/toggle-status" method="POST" class="inline">
                                                    <button type="submit" class="text-xs font-semibold px-2.5 py-1 rounded <%= cpn.isActive ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-200 text-gray-700' %>">
                                                        <%= cpn.isActive ? 'Active' : 'Inactive' %>
                                                    </button>
                                                </form>
                                            </td>
                                            <td class="px-6 py-4 text-right">
                                                <form action="/admin/coupons/<%= cpn._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this coupon permanently?');">
                                                    <button type="submit" class="text-xs text-red-600 hover:text-red-800 font-medium ml-2">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </main>

        </div>

    </div>

    <!-- Create Coupon Modal -->
    <div id="couponModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-5 pb-3 border-b border-gray-100">
                <h3 class="text-lg font-bold text-gray-900">Create New Coupon</h3>
                <button type="button" onclick="closeCouponModal()" class="text-gray-400 hover:text-black">&times;</button>
            </div>

            <form action="/admin/coupons/create" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Coupon Code</label>
                    <input type="text" name="code" required placeholder="e.g. FESTIVE20"
                        class="w-full h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none uppercase font-mono tracking-wider">
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Description (Optional)</label>
                    <input type="text" name="description" placeholder="e.g. 20% off on all festive orders above ₹1,000"
                        class="w-full h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Discount Type</label>
                        <select name="discountType" class="w-full h-11 px-3 border border-gray-300 rounded-lg text-sm bg-white outline-none">
                            <option value="PERCENTAGE">Percentage (%)</option>
                            <option value="FLAT">Flat Amount (₹)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Discount Value</label>
                        <input type="number" name="discountValue" required min="1" step="any" placeholder="e.g. 20"
                            class="w-full h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Min Spend (₹)</label>
                        <input type="number" name="minPurchase" min="0" value="0" placeholder="e.g. 1000"
                            class="w-full h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Max Cap (₹, Optional)</label>
                        <input type="number" name="maxDiscount" min="0" placeholder="e.g. 500"
                            class="w-full h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Total Limit (Optional)</label>
                        <input type="number" name="usageLimit" min="1" placeholder="e.g. 100 (Blank = unlimited)"
                            class="w-full h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Per User Limit</label>
                        <input type="number" name="perUserLimit" min="1" value="1"
                            class="w-full h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Start Date</label>
                        <input type="date" name="startDate" required
                            class="w-full h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">End Date</label>
                        <input type="date" name="endDate" required
                            class="w-full h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none">
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                    <button type="button" onclick="closeCouponModal()" class="px-4 py-2 border rounded-lg text-sm">Cancel</button>
                    <button type="submit" class="px-5 py-2 bg-black text-white rounded-lg text-sm font-semibold hover:bg-gray-800">Save Coupon</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openCouponModal() {
            document.getElementById("couponModal").classList.remove("hidden");
            document.getElementById("couponModal").classList.add("flex");
        }
        function closeCouponModal() {
            document.getElementById("couponModal").classList.add("hidden");
            document.getElementById("couponModal").classList.remove("flex");
        }
    </script>
</body>
</html>
