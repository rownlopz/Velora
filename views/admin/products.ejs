<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VELORA Admin - Product Inventory</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#FAFAF8]">

    <div class="flex">

        <%- include("partials/sidebar", { active: "products" }) %>

        <div class="flex-1 min-w-0">

            <%- include("partials/topbar") %>

            <main class="px-8 py-8 max-w-6xl">

                <p class="text-xs text-gray-400 uppercase tracking-widest mb-2">Admin / Products</p>

                <div class="flex justify-between items-start mb-8">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-900">Product Inventory</h1>
                        <p class="text-gray-500 mt-1">Manage your catalog and monitor stock levels.</p>
                    </div>

                    <a href="/admin/products/add" class="h-11 px-5 bg-black text-white rounded-lg text-sm font-semibold flex items-center">
                        + Add Product
                    </a>
                </div>

                <!-- Search -->
                <div class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
                    <form action="/admin/products" method="GET" class="flex gap-3">
                        <input
                            type="text"
                            name="search"
                            value="<%= search %>"
                            placeholder="Search products by name..."
                            class="flex-1 border border-gray-300 rounded-lg px-4 py-3 outline-none focus:border-black"
                        >
                        <button type="submit" class="h-[46px] px-6 bg-black text-white rounded-lg">Search</button>
                        <% if (search) { %>
                            <a href="/admin/products" class="h-[46px] px-6 border border-gray-300 rounded-lg flex items-center text-sm">Clear</a>
                        <% } %>
                    </form>
                </div>

                <!-- Table -->
                <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr class="text-left text-xs text-gray-400 uppercase tracking-widest">
                                <th class="px-6 py-4 font-medium">Product</th>
                                <th class="px-6 py-4 font-medium">Category</th>
                                <th class="px-6 py-4 font-medium">Stock Status</th>
                                <th class="px-6 py-4 font-medium">Status</th>
                                <th class="px-6 py-4 font-medium">Price</th>
                                <th class="px-6 py-4 font-medium text-right">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (products.length === 0) { %>
                                <tr><td colspan="6" class="text-center py-14 text-gray-400">No products found</td></tr>
                            <% } %>

                            <% products.forEach(product => {
                                let stockLabel = 'In Stock', stockColor = 'text-emerald-600';
                                if (product.totalStock === 0) { stockLabel = 'Out of Stock'; stockColor = 'text-gray-400'; }
                                else if (product.totalStock <= 10) { stockLabel = 'Low Stock'; stockColor = 'text-red-500'; }
                            %>
                                <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-11 h-14 rounded-md bg-gray-100 overflow-hidden shrink-0">
                                                <% if (product.thumbnail) { %>
                                                    <img src="<%= product.thumbnail %>" alt="" class="w-full h-full object-cover">
                                                <% } %>
                                            </div>
                                            <div>
                                                <p class="font-semibold text-gray-900"><%= product.name %></p>
                                                <p class="text-xs text-gray-400"><%= product.brand || '&mdash;' %></p>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="px-6 py-4">
                                        <span class="text-xs bg-gray-100 px-2 py-1 rounded uppercase tracking-wide">
                                            <%= product.categoryId ? product.categoryId.name : '&mdash;' %>
                                        </span>
                                    </td>

                                    <td class="px-6 py-4">
                                        <span class="<%= stockColor %> font-medium">&bull; <%= stockLabel %></span>
                                    </td>

                                    <td class="px-6 py-4">
                                        <!-- Status toggle — uses custom confirm dialog instead of browser confirm() -->
                                        <form id="toggleForm-<%= product._id %>" action="/admin/products/<%= product._id %>/toggle-status" method="POST">
                                            <input type="hidden" name="search" value="<%= search %>">
                                            <input type="hidden" name="page" value="<%= currentPage %>">
                                            <button type="button"
                                                onclick="adminConfirm('Change visibility of this product?', document.getElementById('toggleForm-<%= product._id %>'))"
                                                class="text-xs font-semibold px-2.5 py-1 rounded-full <%= product.status === 'ACTIVE' ? 'bg-emerald-50 text-emerald-600' : 'bg-gray-100 text-gray-500' %>">
                                                <%= product.status === 'ACTIVE' ? 'Listed' : 'Unlisted' %>
                                            </button>
                                        </form>
                                    </td>

                                    <td class="px-6 py-4 text-gray-700">
                                        <% if (product.minPrice === null) { %>
                                            &mdash;
                                        <% } else if (product.minPrice === product.maxPrice) { %>
                                            &#8377;<%= product.minPrice.toLocaleString('en-IN') %>
                                        <% } else { %>
                                            &#8377;<%= product.minPrice.toLocaleString('en-IN') %> &ndash; &#8377;<%= product.maxPrice.toLocaleString('en-IN') %>
                                        <% } %>
                                    </td>

                                    <td class="px-6 py-4">
                                        <div class="flex justify-end gap-3">
                                            <a href="/admin/products/<%= product._id %>/edit" title="Edit" class="text-gray-500 hover:text-black">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                                            </a>
                                            <!-- Delete — uses custom confirm dialog -->
                                            <form id="deleteForm-<%= product._id %>" action="/admin/products/<%= product._id %>/delete" method="POST">
                                                <input type="hidden" name="search" value="<%= search %>">
                                                <input type="hidden" name="page" value="<%= currentPage %>">
                                                <button type="button" title="Delete"
                                                    onclick="adminConfirm('Delete this product? This cannot be undone from the storefront.', document.getElementById('deleteForm-<%= product._id %>'), 'Delete')"
                                                    class="text-gray-500 hover:text-red-600">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>

                    <% if (totalPages > 1) { %>
                        <div class="flex justify-between items-center px-6 py-4 border-t border-gray-200 text-sm text-gray-500">
                            <p>Showing page <%= currentPage %> of <%= totalPages %> &mdash; <%= totalProducts %> products</p>
                            <div class="flex gap-2">
                                <% for (let i = 1; i <= totalPages; i++) { %>
                                    <a href="/admin/products?page=<%= i %>&search=<%= encodeURIComponent(search) %>"
                                        class="w-8 h-8 flex items-center justify-center rounded-lg border text-xs <%= currentPage === i ? 'bg-black text-white border-black' : 'bg-white text-black border-gray-200' %>">
                                        <%= i %>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>

            </main>
        </div>
    </div>

    <!-- Custom Confirm Modal for Admin -->
    <div id="adminConfirmOverlay" class="hidden fixed inset-0 bg-black/40 z-50 flex items-center justify-center px-4">
        <div class="bg-white rounded-2xl w-full max-w-sm p-6 shadow-xl">
            <p id="adminConfirmMsg" class="text-sm text-gray-800 font-medium mb-6 leading-6"></p>
            <div class="flex justify-end gap-3">
                <button id="adminConfirmCancel" type="button"
                    class="px-5 py-2.5 border border-gray-300 rounded-lg text-sm font-medium hover:bg-gray-50 transition">
                    Cancel
                </button>
                <button id="adminConfirmOk" type="button"
                    class="px-5 py-2.5 bg-black text-white rounded-lg text-sm font-semibold hover:bg-gray-800 transition">
                    Confirm
                </button>
            </div>
        </div>
    </div>

    <script>
        let _adminConfirmTarget = null;

        function adminConfirm(message, formEl, okLabel) {
            document.getElementById('adminConfirmMsg').textContent = message;
            document.getElementById('adminConfirmOk').textContent = okLabel || 'Confirm';
            _adminConfirmTarget = formEl;
            document.getElementById('adminConfirmOverlay').classList.remove('hidden');
        }

        document.getElementById('adminConfirmCancel').addEventListener('click', () => {
            document.getElementById('adminConfirmOverlay').classList.add('hidden');
            _adminConfirmTarget = null;
        });

        document.getElementById('adminConfirmOk').addEventListener('click', () => {
            document.getElementById('adminConfirmOverlay').classList.add('hidden');
            if (_adminConfirmTarget) _adminConfirmTarget.submit();
            _adminConfirmTarget = null;
        });

        document.getElementById('adminConfirmOverlay').addEventListener('click', function (e) {
            if (e.target === this) {
                this.classList.add('hidden');
                _adminConfirmTarget = null;
            }
        });
    </script>

</body>
</html>
