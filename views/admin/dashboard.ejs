<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Dashboard | VELORA Admin' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-[#FAFAF8]">

    <div class="flex">

        <%- include("partials/sidebar", { active: "dashboard" }) %>

        <div class="flex-1 min-w-0">

            <%- include("partials/topbar") %>

            <main class="px-8 py-8 max-w-7xl">

                <div class="flex justify-between items-start mb-8">
                    <div>
                        <p class="text-xs text-gray-400 uppercase tracking-widest mb-1">Admin / Analytics</p>
                        <h1 class="text-3xl font-bold text-gray-900">Store Dashboard</h1>
                        <div class="mt-2.5 flex flex-wrap items-center gap-2.5">
                            <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-white border border-gray-200 rounded-lg shadow-sm">
                                <span class="text-xs text-gray-500 font-medium">Today's Net Sales:</span>
                                <span class="text-sm font-bold text-gray-900">₹<%= (typeof todaySales !== 'undefined' ? todaySales : 0).toLocaleString('en-IN') %></span>
                            </div>
                            <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-white border border-gray-200 rounded-lg shadow-sm">
                                <span class="text-xs text-gray-500 font-medium">Yesterday's Net Sales:</span>
                                <span class="text-sm font-bold text-gray-900">₹<%= (typeof yesterdaySales !== 'undefined' ? yesterdaySales : 0).toLocaleString('en-IN') %></span>
                            </div>
                            <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-gray-50 border border-gray-200 rounded-lg shadow-sm">
                                <span class="text-xs text-gray-600 font-medium">Last 2 Days:</span>
                                <span class="text-sm font-bold text-gray-900">₹<%= (typeof totalSales !== 'undefined' ? totalSales : (typeof lastTwoDaysSales !== 'undefined' ? lastTwoDaysSales : 0)).toLocaleString('en-IN') %></span>
                            </div>
                        </div>
                        <p class="text-gray-500 mt-2 text-sm">Real-time performance overview, sales trends, and top performers.</p>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="flex items-center bg-white border border-gray-200 rounded-lg p-1 shadow-sm">
                            <a href="/admin/dashboard?filterType=daily" class="px-3 py-1.5 text-xs font-semibold rounded-md transition <%= typeof filterType !== 'undefined' && filterType === 'daily' ? 'bg-black text-white' : 'text-gray-600 hover:text-black' %>">Daily</a>
                            <a href="/admin/dashboard?filterType=weekly" class="px-3 py-1.5 text-xs font-semibold rounded-md transition <%= typeof filterType !== 'undefined' && filterType === 'weekly' ? 'bg-black text-white' : 'text-gray-600 hover:text-black' %>">Weekly</a>
                            <a href="/admin/dashboard?filterType=monthly" class="px-3 py-1.5 text-xs font-semibold rounded-md transition <%= typeof filterType === 'undefined' || filterType === 'monthly' ? 'bg-black text-white' : 'text-gray-600 hover:text-black' %>">Monthly</a>
                            <a href="/admin/dashboard?filterType=yearly" class="px-3 py-1.5 text-xs font-semibold rounded-md transition <%= typeof filterType !== 'undefined' && filterType === 'yearly' ? 'bg-black text-white' : 'text-gray-600 hover:text-black' %>">Yearly</a>
                        </div>
                        <a href="/admin/sales-report" class="h-10 px-4 inline-flex items-center gap-2 bg-black text-white rounded-lg text-sm font-semibold hover:bg-gray-800 transition shadow-sm">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
                            View Sales Report
                        </a>
                    </div>
                </div>

                <%
                    let periodLabel = 'Monthly';
                    let periodDesc = 'past 12 months';
                    let badgeText = 'Trailing 12M';
                    if (typeof filterType !== 'undefined') {
                        if (filterType === 'daily') {
                            periodLabel = 'Daily';
                            periodDesc = 'past 30 days';
                            badgeText = 'Last 30 Days';
                        } else if (filterType === 'weekly') {
                            periodLabel = 'Weekly';
                            periodDesc = 'past 12 weeks';
                            badgeText = 'Last 12 Weeks';
                        } else if (filterType === 'yearly') {
                            periodLabel = 'Yearly';
                            periodDesc = 'trailing 5 years';
                            badgeText = 'Trailing 5Y';
                        }
                    }
                %>

                <!-- Charts Section -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">

                    <!-- Revenue Trend Chart -->
                    <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
                        <div class="flex justify-between items-center mb-6">
                            <div>
                                <h3 class="font-semibold text-gray-900 text-base"><%= periodLabel %> Revenue Trend</h3>
                                <p class="text-xs text-gray-400 mt-0.5">Recognized revenue over <%= periodDesc %></p>
                            </div>
                            <span class="text-xs px-2.5 py-1 bg-gray-100 rounded-md font-medium text-gray-600"><%= badgeText %></span>
                        </div>
                        <div class="h-64">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>

                    <!-- Order Volume Chart -->
                    <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
                        <div class="flex justify-between items-center mb-6">
                            <div>
                                <h3 class="font-semibold text-gray-900 text-base"><%= periodLabel %> Order Volume</h3>
                                <p class="text-xs text-gray-400 mt-0.5">Successful orders placed over <%= periodDesc %></p>
                            </div>
                            <span class="text-xs px-2.5 py-1 bg-gray-100 rounded-md font-medium text-gray-600"><%= badgeText %></span>
                        </div>
                        <div class="h-64">
                            <canvas id="ordersChart"></canvas>
                        </div>
                    </div>

                </div>

                <!-- Top 10 Best Sellers Section -->
                <div class="space-y-8">

                    <!-- Top 10 Products -->
                    <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
                        <div class="p-6 border-b border-gray-100 flex justify-between items-center">
                            <div>
                                <h3 class="font-bold text-gray-900 text-lg">Top 10 Best-Selling Products</h3>
                                <p class="text-xs text-gray-400 mt-0.5">Ranked by net units sold (excluding cancelled and returned units)</p>
                            </div>
                            <span class="text-xs px-2.5 py-1 bg-emerald-50 text-emerald-700 font-semibold rounded-md uppercase tracking-wider">Top Performers</span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-400 uppercase tracking-widest text-left">
                                    <tr>
                                        <th class="px-6 py-4 font-medium">Rank</th>
                                        <th class="px-6 py-4 font-medium">Product</th>
                                        <th class="px-6 py-4 font-medium text-right">Units Sold</th>
                                        <th class="px-6 py-4 font-medium text-right">Net Revenue</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    <% if (!topProducts || topProducts.length === 0) { %>
                                        <tr>
                                            <td colspan="4" class="px-6 py-10 text-center text-gray-400 text-sm">No sales data recorded yet.</td>
                                        </tr>
                                    <% } else { %>
                                        <% topProducts.forEach((p, idx) => { %>
                                            <tr class="hover:bg-gray-50 transition">
                                                <td class="px-6 py-4 font-semibold text-gray-400">#<%= idx + 1 %></td>
                                                <td class="px-6 py-4">
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-10 h-10 rounded-lg bg-gray-100 overflow-hidden shrink-0">
                                                            <% if (p.thumbnail) { %>
                                                                <img src="<%= p.thumbnail %>" alt="" class="w-full h-full object-cover">
                                                            <% } %>
                                                        </div>
                                                        <div>
                                                            <p class="font-medium text-gray-900"><%= p.productName %></p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 text-right font-semibold text-gray-900"><%= p.totalUnitsSold.toLocaleString('en-IN') %></td>
                                                <td class="px-6 py-4 text-right text-gray-700">&#8377;<%= p.totalRevenue.toLocaleString('en-IN') %></td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Top 10 Categories and Brands Grid -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

                        <!-- Top 10 Categories -->
                        <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
                            <div class="p-6 border-b border-gray-100">
                                <h3 class="font-bold text-gray-900 text-base">Top 10 Categories</h3>
                                <p class="text-xs text-gray-400 mt-0.5">By net units sold</p>
                            </div>
                            <table class="w-full text-sm">
                                <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-400 uppercase tracking-widest text-left">
                                    <tr>
                                        <th class="px-6 py-3 font-medium">Rank</th>
                                        <th class="px-6 py-3 font-medium">Category</th>
                                        <th class="px-6 py-3 font-medium text-right">Units</th>
                                        <th class="px-6 py-3 font-medium text-right">Revenue</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    <% if (!topCategories || topCategories.length === 0) { %>
                                        <tr>
                                            <td colspan="4" class="px-6 py-8 text-center text-gray-400 text-sm">No category sales yet.</td>
                                        </tr>
                                    <% } else { %>
                                        <% topCategories.forEach((c, idx) => { %>
                                            <tr class="hover:bg-gray-50">
                                                <td class="px-6 py-3.5 text-gray-400 font-semibold">#<%= idx + 1 %></td>
                                                <td class="px-6 py-3.5 font-medium text-gray-900"><%= c.categoryName %></td>
                                                <td class="px-6 py-3.5 text-right font-semibold text-gray-900"><%= c.totalUnitsSold.toLocaleString('en-IN') %></td>
                                                <td class="px-6 py-3.5 text-right text-gray-700">&#8377;<%= c.totalRevenue.toLocaleString('en-IN') %></td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Top 10 Brands -->
                        <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
                            <div class="p-6 border-b border-gray-100">
                                <h3 class="font-bold text-gray-900 text-base">Top 10 Brands</h3>
                                <p class="text-xs text-gray-400 mt-0.5">By net units sold</p>
                            </div>
                            <table class="w-full text-sm">
                                <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-400 uppercase tracking-widest text-left">
                                    <tr>
                                        <th class="px-6 py-3 font-medium">Rank</th>
                                        <th class="px-6 py-3 font-medium">Brand</th>
                                        <th class="px-6 py-3 font-medium text-right">Units</th>
                                        <th class="px-6 py-3 font-medium text-right">Revenue</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    <% if (!topBrands || topBrands.length === 0) { %>
                                        <tr>
                                            <td colspan="4" class="px-6 py-8 text-center text-gray-400 text-sm">No brand sales yet.</td>
                                        </tr>
                                    <% } else { %>
                                        <% topBrands.forEach((b, idx) => { %>
                                            <tr class="hover:bg-gray-50">
                                                <td class="px-6 py-3.5 text-gray-400 font-semibold">#<%= idx + 1 %></td>
                                                <td class="px-6 py-3.5 font-medium text-gray-900"><%= b.brandName %></td>
                                                <td class="px-6 py-3.5 text-right font-semibold text-gray-900"><%= b.totalUnitsSold.toLocaleString('en-IN') %></td>
                                                <td class="px-6 py-3.5 text-right text-gray-700">&#8377;<%= b.totalRevenue.toLocaleString('en-IN') %></td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                    </div>

                </div>

            </main>

        </div>

    </div>

    <!-- Chart.js Initialization -->
    <script>
        const chartData = <%- JSON.stringify(monthlyStats || []).replace(/</g, '\\u003c') %>;

        const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        const labels = chartData.map(d => {
            if (d.label) return d.label;
            if (d._id && d._id.month && d._id.year) return `${months[d._id.month - 1]} ${d._id.year}`;
            if (d._id && d._id.year) return String(d._id.year);
            return "N/A";
        });
        const revenueValues = chartData.map(d => Number(d.totalRevenue) || 0);
        const orderValues = chartData.map(d => Number(d.orderCount) || 0);

        // Revenue Line Chart
        const revCanvas = document.getElementById('revenueChart');
        if (revCanvas) {
            const ctx = revCanvas.getContext('2d');
            const gradient = ctx.createLinearGradient(0, 0, 0, 240);
            gradient.addColorStop(0, 'rgba(17, 24, 39, 0.16)');
            gradient.addColorStop(1, 'rgba(17, 24, 39, 0.00)');

            new Chart(revCanvas, {
                type: 'line',
                data: {
                    labels: labels.length ? labels : ["No Data"],
                    datasets: [{
                        label: 'Revenue',
                        data: revenueValues.length ? revenueValues : [0],
                        borderColor: '#111827',
                        backgroundColor: gradient,
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.35,
                        pointRadius: chartData.length > 20 ? 2 : 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#FFFFFF',
                        pointBorderColor: '#111827',
                        pointBorderWidth: 2,
                    }]
                },
                options: {
                    animation: false,
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#111827',
                            titleColor: '#F9FAFB',
                            bodyColor: '#F9FAFB',
                            padding: 10,
                            cornerRadius: 8,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    return ' Revenue: ₹' + Number(context.parsed.y).toLocaleString('en-IN');
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: {
                                color: '#6B7280',
                                font: { size: 11 },
                                maxRotation: 45,
                                minRotation: 0,
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: '#F3F4F6' },
                            ticks: {
                                color: '#6B7280',
                                font: { size: 11 },
                                callback: function(value) {
                                    if (value >= 100000) return '₹' + (value / 100000).toFixed(1) + 'L';
                                    if (value >= 1000) return '₹' + (value / 1000).toFixed(0) + 'k';
                                    return '₹' + value.toLocaleString('en-IN');
                                }
                            }
                        }
                    }
                }
            });
        }

        // Orders Bar Chart
        const ordCanvas = document.getElementById('ordersChart');
        if (ordCanvas) {
            new Chart(ordCanvas, {
                type: 'bar',
                data: {
                    labels: labels.length ? labels : ["No Data"],
                    datasets: [{
                        label: 'Orders',
                        data: orderValues.length ? orderValues : [0],
                        backgroundColor: '#1F2937',
                        hoverBackgroundColor: '#111827',
                        borderRadius: 6,
                        maxBarThickness: chartData.length > 20 ? 16 : 32,
                    }]
                },
                options: {
                    animation: false,
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#111827',
                            titleColor: '#F9FAFB',
                            bodyColor: '#F9FAFB',
                            padding: 10,
                            cornerRadius: 8,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    return ' Orders: ' + context.parsed.y + ' placed';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: {
                                color: '#6B7280',
                                font: { size: 11 },
                                maxRotation: 45,
                                minRotation: 0,
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: '#F3F4F6' },
                            ticks: {
                                precision: 0,
                                color: '#6B7280',
                                font: { size: 11 },
                            }
                        }
                    }
                }
            });
        }
    </script>
</body>
</html>
