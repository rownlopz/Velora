<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Dashboard | VELORA Admin' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-[#FAFAF8]">

    <div class="flex">

        <%- include("partials/sidebar", { active: "dashboard" }) %>

        <div class="flex-1 min-w-0">

            <%- include("partials/topbar") %>

            <main class="px-8 py-8 max-w-7xl">

                <div class="flex justify-between items-start mb-8">
                    <div>
                        <p class="text-xs text-gray-400 uppercase tracking-widest mb-1">Admin / Analytics</p>
                        <h1 class="text-3xl font-bold text-gray-900">Store Dashboard</h1>
                        <p class="text-gray-500 mt-1">Real-time performance overview, sales trends, and top performers.</p>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="flex items-center bg-white border border-gray-200 rounded-lg p-1">
                            <a href="/admin/dashboard?filterType=monthly" class="px-3 py-1.5 text-xs font-semibold rounded-md transition <%= typeof filterType === 'undefined' || filterType === 'monthly' ? 'bg-black text-white' : 'text-gray-600 hover:text-black' %>">Monthly</a>
                            <a href="/admin/dashboard?filterType=yearly" class="px-3 py-1.5 text-xs font-semibold rounded-md transition <%= typeof filterType !== 'undefined' && filterType === 'yearly' ? 'bg-black text-white' : 'text-gray-600 hover:text-black' %>">Yearly</a>
                        </div>
                        <a href="/admin/sales-report" class="h-10 px-4 inline-flex items-center gap-2 bg-black text-white rounded-lg text-sm font-semibold hover:bg-gray-800 transition">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
                            View Sales Report
                        </a>
                    </div>
                </div>

                <!-- Charts Section -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">

                    <!-- Revenue Trend Chart -->
                    <div class="bg-white p-6 rounded-2xl border border-gray-200">
                        <div class="flex justify-between items-center mb-6">
                            <div>
                                <h3 class="font-semibold text-gray-900 text-base"><%= typeof filterType !== 'undefined' && filterType === 'yearly' ? 'Yearly' : 'Monthly' %> Revenue Trend</h3>
                                <p class="text-xs text-gray-400 mt-0.5">Recognized revenue over <%= typeof filterType !== 'undefined' && filterType === 'yearly' ? 'trailing 5 years' : 'past 12 months' %></p>
                            </div>
                            <span class="text-xs px-2.5 py-1 bg-gray-100 rounded-md font-medium text-gray-600"><%= typeof filterType !== 'undefined' && filterType === 'yearly' ? 'Yearly' : 'Trailing 12M' %></span>
                        </div>
                        <div class="h-64">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>

                    <!-- Order Volume Chart -->
                    <div class="bg-white p-6 rounded-2xl border border-gray-200">
                        <div class="flex justify-between items-center mb-6">
                            <div>
                                <h3 class="font-semibold text-gray-900 text-base"><%= typeof filterType !== 'undefined' && filterType === 'yearly' ? 'Yearly' : 'Monthly' %> Order Volume</h3>
                                <p class="text-xs text-gray-400 mt-0.5">Total successful orders placed</p>
                            </div>
                            <span class="text-xs px-2.5 py-1 bg-gray-100 rounded-md font-medium text-gray-600"><%= typeof filterType !== 'undefined' && filterType === 'yearly' ? 'Yearly' : 'Trailing 12M' %></span>
                        </div>
                        <div class="h-64">
                            <canvas id="ordersChart"></canvas>
                        </div>
                    </div>

                </div>

                <!-- Top 10 Best Sellers Section -->
                <div class="space-y-8">

                    <!-- Top 10 Products -->
                    <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
                        <div class="p-6 border-b border-gray-100 flex justify-between items-center">
                            <div>
                                <h3 class="font-bold text-gray-900 text-lg">Top 10 Best-Selling Products</h3>
                                <p class="text-xs text-gray-400 mt-0.5">Ranked by net units sold (excluding cancelled and returned units)</p>
                            </div>
                            <span class="text-xs px-2.5 py-1 bg-emerald-50 text-emerald-700 font-semibold rounded-md uppercase tracking-wider">Top Performers</span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-400 uppercase tracking-widest text-left">
                                    <tr>
                                        <th class="px-6 py-4 font-medium">Rank</th>
                                        <th class="px-6 py-4 font-medium">Product</th>
                                        <th class="px-6 py-4 font-medium text-right">Units Sold</th>
                                        <th class="px-6 py-4 font-medium text-right">Net Revenue</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    <% if (!topProducts || topProducts.length === 0) { %>
                                        <tr>
                                            <td colspan="4" class="px-6 py-10 text-center text-gray-400 text-sm">No sales data recorded yet.</td>
                                        </tr>
                                    <% } else { %>
                                        <% topProducts.forEach((p, idx) => { %>
                                            <tr class="hover:bg-gray-50 transition">
                                                <td class="px-6 py-4 font-semibold text-gray-400">#<%= idx + 1 %></td>
                                                <td class="px-6 py-4">
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-10 h-10 rounded-lg bg-gray-100 overflow-hidden shrink-0">
                                                            <% if (p.thumbnail) { %>
                                                                <img src="<%= p.thumbnail %>" alt="" class="w-full h-full object-cover">
                                                            <% } %>
                                                        </div>
                                                        <div>
                                                            <p class="font-medium text-gray-900"><%= p.productName %></p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 text-right font-semibold text-gray-900"><%= p.totalUnitsSold.toLocaleString('en-IN') %></td>
                                                <td class="px-6 py-4 text-right text-gray-700">&#8377;<%= p.totalRevenue.toLocaleString('en-IN') %></td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Top 10 Categories and Brands Grid -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

                        <!-- Top 10 Categories -->
                        <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
                            <div class="p-6 border-b border-gray-100">
                                <h3 class="font-bold text-gray-900 text-base">Top 10 Categories</h3>
                                <p class="text-xs text-gray-400 mt-0.5">By net units sold</p>
                            </div>
                            <table class="w-full text-sm">
                                <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-400 uppercase tracking-widest text-left">
                                    <tr>
                                        <th class="px-6 py-3 font-medium">Rank</th>
                                        <th class="px-6 py-3 font-medium">Category</th>
                                        <th class="px-6 py-3 font-medium text-right">Units</th>
                                        <th class="px-6 py-3 font-medium text-right">Revenue</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    <% if (!topCategories || topCategories.length === 0) { %>
                                        <tr>
                                            <td colspan="4" class="px-6 py-8 text-center text-gray-400 text-sm">No category sales yet.</td>
                                        </tr>
                                    <% } else { %>
                                        <% topCategories.forEach((c, idx) => { %>
                                            <tr class="hover:bg-gray-50">
                                                <td class="px-6 py-3.5 text-gray-400 font-semibold">#<%= idx + 1 %></td>
                                                <td class="px-6 py-3.5 font-medium text-gray-900"><%= c.categoryName %></td>
                                                <td class="px-6 py-3.5 text-right font-semibold text-gray-900"><%= c.totalUnitsSold.toLocaleString('en-IN') %></td>
                                                <td class="px-6 py-3.5 text-right text-gray-700">&#8377;<%= c.totalRevenue.toLocaleString('en-IN') %></td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Top 10 Brands -->
                        <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
                            <div class="p-6 border-b border-gray-100">
                                <h3 class="font-bold text-gray-900 text-base">Top 10 Brands</h3>
                                <p class="text-xs text-gray-400 mt-0.5">By net units sold</p>
                            </div>
                            <table class="w-full text-sm">
                                <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-400 uppercase tracking-widest text-left">
                                    <tr>
                                        <th class="px-6 py-3 font-medium">Rank</th>
                                        <th class="px-6 py-3 font-medium">Brand</th>
                                        <th class="px-6 py-3 font-medium text-right">Units</th>
                                        <th class="px-6 py-3 font-medium text-right">Revenue</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    <% if (!topBrands || topBrands.length === 0) { %>
                                        <tr>
                                            <td colspan="4" class="px-6 py-8 text-center text-gray-400 text-sm">No brand sales yet.</td>
                                        </tr>
                                    <% } else { %>
                                        <% topBrands.forEach((b, idx) => { %>
                                            <tr class="hover:bg-gray-50">
                                                <td class="px-6 py-3.5 text-gray-400 font-semibold">#<%= idx + 1 %></td>
                                                <td class="px-6 py-3.5 font-medium text-gray-900"><%= b.brandName %></td>
                                                <td class="px-6 py-3.5 text-right font-semibold text-gray-900"><%= b.totalUnitsSold.toLocaleString('en-IN') %></td>
                                                <td class="px-6 py-3.5 text-right text-gray-700">&#8377;<%= b.totalRevenue.toLocaleString('en-IN') %></td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                    </div>

                </div>

            </main>

        </div>

    </div>

    <!-- Chart.js Initialization -->
    <script>
        const monthlyData = <%- JSON.stringify(monthlyStats || []).replace(/</g, '\\u003c') %>;

        const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        const labels = monthlyData.map(d => d._id && d._id.month ? `${months[d._id.month - 1]} ${d._id.year}` : `${d._id.year}`);
        const revenueValues = monthlyData.map(d => d.totalRevenue);
        const orderValues = monthlyData.map(d => d.orderCount);

        // Revenue Chart
        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: labels.length ? labels : ["No Data"],
                datasets: [{
                    label: 'Revenue (₹)',
                    data: revenueValues.length ? revenueValues : [0],
                    borderColor: '#000000',
                    backgroundColor: 'rgba(0, 0, 0, 0.05)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) { return '₹' + value.toLocaleString('en-IN'); }
                        }
                    }
                }
            }
        });

        // Orders Chart
        new Chart(document.getElementById('ordersChart'), {
            type: 'bar',
            data: {
                labels: labels.length ? labels : ["No Data"],
                datasets: [{
                    label: 'Orders',
                    data: orderValues.length ? orderValues : [0],
                    backgroundColor: '#1F2937',
                    borderRadius: 6,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { precision: 0 }
                    }
                }
            }
        });
    </script>
</body>
</html>
