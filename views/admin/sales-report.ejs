<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Sales Report | VELORA Admin' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#FAFAF8]">

    <div class="flex">

        <%- include("partials/sidebar", { active: "sales-report" }) %>

        <div class="flex-1 min-w-0">

            <%- include("partials/topbar") %>

            <main class="px-8 py-8 max-w-7xl">

                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
                    <div>
                        <p class="text-xs text-gray-400 uppercase tracking-widest mb-1">Admin / Reports</p>
                        <h1 class="text-3xl font-bold text-gray-900">Sales Report</h1>
                        <p class="text-gray-500 mt-1">
                            Audited revenue, order volume, discounts, and return deductions.
                        </p>
                    </div>

                    <!-- Download Buttons -->
                    <div class="flex items-center gap-3">
                        <a href="/admin/sales-report/export/excel?rangeType=<%= rangeType %>&startDate=<%= startDate %>&endDate=<%= endDate %>"
                            class="h-11 px-4 inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-sm font-semibold transition">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m10 12 4 4m0-4-4 4"/></svg>
                            Export Excel
                        </a>

                        <a href="/admin/sales-report/export/pdf?rangeType=<%= rangeType %>&startDate=<%= startDate %>&endDate=<%= endDate %>"
                            class="h-11 px-4 inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-semibold transition">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
                            Export PDF
                        </a>
                    </div>
                </div>

                <!-- Range Selector Form -->
                <div class="bg-white p-6 rounded-2xl border border-gray-200 mb-8">
                    <form action="/admin/sales-report" method="GET" class="flex flex-wrap items-end gap-4">

                        <div>
                            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Preset Period</label>
                            <select name="rangeType" id="rangeTypeSelect" onchange="toggleCustomDates()"
                                class="h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none bg-white">
                                <option value="daily" <%= rangeType === "daily" ? "selected" : "" %>>Today (Daily)</option>
                                <option value="weekly" <%= rangeType === "weekly" ? "selected" : "" %>>Last 7 Days (Weekly)</option>
                                <option value="yearly" <%= rangeType === "yearly" ? "selected" : "" %>>Current Year (Yearly)</option>
                                <option value="custom" <%= rangeType === "custom" ? "selected" : "" %>>Custom Date Range</option>
                            </select>
                        </div>

                        <div id="customDateFields" class="<%= rangeType === 'custom' ? 'flex' : 'hidden' %> items-end gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Start Date</label>
                                <input type="date" name="startDate" value="<%= startDate %>"
                                    class="h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">End Date</label>
                                <input type="date" name="endDate" value="<%= endDate %>"
                                    class="h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none">
                            </div>
                        </div>

                        <button type="submit" class="h-11 px-6 bg-black text-white rounded-lg text-sm font-semibold hover:bg-gray-800 transition">
                            Apply Filter
                        </button>

                    </form>
                </div>

                <!-- Summary KPI Cards -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">

                    <div class="bg-white p-5 rounded-xl border border-gray-200">
                        <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Total Orders</p>
                        <p class="text-2xl font-bold text-gray-900 mt-2"><%= summary.totalOrdersCount.toLocaleString('en-IN') %></p>
                        <p class="text-xs text-gray-500 mt-1"><%= summary.totalUnitsSold.toLocaleString('en-IN') %> net units sold</p>
                    </div>

                    <div class="bg-white p-5 rounded-xl border border-gray-200">
                        <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Gross Order Amount</p>
                        <p class="text-2xl font-bold text-gray-900 mt-2">&#8377;<%= summary.totalGrossAmount.toLocaleString('en-IN') %></p>
                        <p class="text-xs text-gray-500 mt-1">Pre-discount catalog total</p>
                    </div>

                    <div class="bg-white p-5 rounded-xl border border-gray-200">
                        <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Discounts Deducted</p>
                        <p class="text-2xl font-bold text-amber-600 mt-2">&#8377;<%= (summary.totalOfferDiscount + summary.totalCouponDiscount).toLocaleString('en-IN') %></p>
                        <p class="text-xs text-gray-500 mt-1">Offers: &#8377;<%= summary.totalOfferDiscount.toLocaleString('en-IN') %> &bull; Coupons: &#8377;<%= summary.totalCouponDiscount.toLocaleString('en-IN') %></p>
                    </div>

                    <div class="bg-white p-5 rounded-xl border border-gray-200">
                        <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Net Sales Recognized</p>
                        <p class="text-2xl font-bold text-emerald-600 mt-2">&#8377;<%= summary.netSalesRecognized.toLocaleString('en-IN') %></p>
                        <p class="text-xs text-gray-500 mt-1">After returns (&#8377;<%= summary.totalRefundsOrCancellations.toLocaleString('en-IN') %>)</p>
                    </div>

                </div>

                <!-- Orders Table -->
                <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
                    <div class="p-6 border-b border-gray-100 flex justify-between items-center">
                        <h3 class="font-bold text-gray-900 text-base">Orders Included in Report</h3>
                        <span class="text-xs text-gray-500">Showing page <%= currentPage %> of <%= totalPages %></span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-400 uppercase tracking-widest text-left">
                                <tr>
                                    <th class="px-6 py-4 font-medium">Order Number</th>
                                    <th class="px-6 py-4 font-medium">Date</th>
                                    <th class="px-6 py-4 font-medium">Customer</th>
                                    <th class="px-6 py-4 font-medium">Payment</th>
                                    <th class="px-6 py-4 font-medium">Status</th>
                                    <th class="px-6 py-4 font-medium text-right">Gross</th>
                                    <th class="px-6 py-4 font-medium text-right">Coupon</th>
                                    <th class="px-6 py-4 font-medium text-right">Net Payable</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                <% if (!orders || orders.length === 0) { %>
                                    <tr>
                                        <td colspan="8" class="px-6 py-12 text-center text-gray-400 text-sm">
                                            No orders placed within this date range.
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% orders.forEach((ord) => { %>
                                        <tr class="hover:bg-gray-50 transition">
                                            <td class="px-6 py-4 font-semibold text-gray-900">
                                                <a href="/admin/orders/<%= ord._id %>" class="hover:underline">
                                                    <%= ord.orderNumber %>
                                                </a>
                                            </td>
                                            <td class="px-6 py-4 text-gray-600">
                                                <%= new Date(ord.placedAt).toLocaleDateString('en-IN', { month: 'short', day: '2-digit', year: 'numeric' }) %>
                                            </td>
                                            <td class="px-6 py-4">
                                                <p class="font-medium text-gray-900"><%= ord.customerName %></p>
                                                <p class="text-xs text-gray-400"><%= ord.customerEmail %></p>
                                            </td>
                                            <td class="px-6 py-4">
                                                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-gray-100 text-gray-700">
                                                    <%= ord.paymentMethod %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-4">
                                                <span class="text-xs font-semibold px-2 py-0.5 rounded <%= ord.orderStatus === 'DELIVERED' ? 'bg-emerald-100 text-emerald-800' : (ord.orderStatus === 'CANCELLED' ? 'bg-red-100 text-red-800' : 'bg-blue-100 text-blue-800') %>">
                                                    <%= ord.orderStatus.replace(/_/g, " ") %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-right text-gray-700">&#8377;<%= ord.grossAmount.toLocaleString('en-IN') %></td>
                                            <td class="px-6 py-4 text-right text-amber-600">-&#8377;<%= ord.couponDiscount.toLocaleString('en-IN') %></td>
                                            <td class="px-6 py-4 text-right font-bold text-gray-900">&#8377;<%= ord.netPayable.toLocaleString('en-IN') %></td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (totalPages > 1) { %>
                        <div class="px-6 py-4 border-t border-gray-100 flex justify-between items-center text-sm">
                            <% if (currentPage > 1) { %>
                                <a href="/admin/sales-report?rangeType=<%= rangeType %>&startDate=<%= startDate %>&endDate=<%= endDate %>&page=<%= currentPage - 1 %>"
                                    class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">
                                    &larr; Previous
                                </a>
                            <% } else { %>
                                <div></div>
                            <% } %>

                            <span class="text-gray-500">Page <%= currentPage %> of <%= totalPages %></span>

                            <% if (currentPage < totalPages) { %>
                                <a href="/admin/sales-report?rangeType=<%= rangeType %>&startDate=<%= startDate %>&endDate=<%= endDate %>&page=<%= currentPage + 1 %>"
                                    class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">
                                    Next &rarr;
                                </a>
                            <% } else { %>
                                <div></div>
                            <% } %>
                        </div>
                    <% } %>

                </div>

            </main>

        </div>

    </div>

    <script>
        function toggleCustomDates() {
            const select = document.getElementById("rangeTypeSelect");
            const fields = document.getElementById("customDateFields");
            if (select.value === "custom") {
                fields.classList.remove("hidden");
                fields.classList.add("flex");
            } else {
                fields.classList.add("hidden");
                fields.classList.remove("flex");
            }
        }
    </script>
</body>
</html>
