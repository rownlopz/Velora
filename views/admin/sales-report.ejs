<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Sales Report | VELORA Admin' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#FAFAF8]">

    <div class="flex">

        <%- include("partials/sidebar", { active: "sales-report" }) %>

        <div class="flex-1 min-w-0">

            <%- include("partials/topbar") %>

            <main class="px-8 py-8 max-w-7xl">

                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
                    <div>
                        <p class="text-xs text-gray-400 uppercase tracking-widest mb-1">Admin / Reports</p>
                        <h1 class="text-3xl font-bold text-gray-900">Sales Report</h1>
                        <p class="text-gray-500 mt-1">
                            Audited revenue, order volume, discounts, and return deductions.
                        </p>
                    </div>

                    <!-- Download Buttons -->
                    <div class="flex items-center gap-3">
                        <a href="/admin/sales-report/export/excel?rangeType=<%= rangeType %>&startDate=<%= startDate %>&endDate=<%= endDate %>"
                            class="h-11 px-4 inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-sm font-semibold transition">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m10 12 4 4m0-4-4 4"/></svg>
                            Export Excel
                        </a>

                        <a href="/admin/sales-report/export/pdf?rangeType=<%= rangeType %>&startDate=<%= startDate %>&endDate=<%= endDate %>"
                            class="h-11 px-4 inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-semibold transition">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
                            Export PDF
                        </a>
                    </div>
                </div>

                <!-- Range Selector Form -->
                <div class="bg-white p-6 rounded-2xl border border-gray-200 mb-8">
                    <form action="/admin/sales-report" method="GET" class="flex flex-wrap items-end gap-4">

                        <div>
                            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Preset Period</label>
                            <select name="rangeType" id="rangeTypeSelect" onchange="toggleCustomDates()"
                                class="h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none bg-white">
                                <option value="daily" <%= rangeType === "daily" ? "selected" : "" %>>Today (Daily)</option>
                                <option value="weekly" <%= rangeType === "weekly" ? "selected" : "" %>>Last 7 Days (Weekly)</option>
                                <option value="yearly" <%= rangeType === "yearly" ? "selected" : "" %>>Current Year (Yearly)</option>
                                <option value="custom" <%= rangeType === "custom" ? "selected" : "" %>>Custom Date Range</option>
                            </select>
                        </div>

                        <div id="customDateFields" class="<%= rangeType === 'custom' ? 'flex' : 'hidden' %> items-end gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Start Date</label>
                                <input type="date" name="startDate" value="<%= startDate %>"
                                    class="h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">End Date</label>
                                <input type="date" name="endDate" value="<%= endDate %>"
                                    class="h-11 px-4 border border-gray-300 rounded-lg text-sm focus:border-black outline-none">
                            </div>
                        </div>

                        <button type="submit" class="h-11 px-6 bg-black text-white rounded-lg text-sm font-semibold hover:bg-gray-800 transition">
                            Apply Filter
                        </button>

                    </form>
                </div>

                <!-- Summary KPI Cards -->
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">

                    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
                        <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Orders Placed</p>
                        <p class="text-2xl font-bold text-gray-900 mt-2"><%= (summary.ordersPlaced || summary.totalOrdersCount || 0).toLocaleString('en-IN') %></p>
                        <p class="text-xs text-gray-500 mt-1"><%= (summary.totalUnitsSold || 0).toLocaleString('en-IN') %> net units active/sold</p>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
                        <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Gross Merchandise Value</p>
                        <p class="text-2xl font-bold text-gray-900 mt-2">&#8377;<%= (summary.merchandiseSales || summary.totalGrossAmount || 0).toLocaleString('en-IN') %></p>
                        <p class="text-xs text-gray-500 mt-1">Pre-discount catalog amount</p>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
                        <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Promotional Offer Savings</p>
                        <p class="text-2xl font-bold text-amber-600 mt-2">-&#8377;<%= (summary.offerDiscounts || summary.totalOfferDiscount || 0).toLocaleString('en-IN') %></p>
                        <p class="text-xs text-gray-500 mt-1">Product & category promotions</p>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
                        <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Coupon Discounts</p>
                        <p class="text-2xl font-bold text-amber-600 mt-2">-&#8377;<%= (summary.couponDiscounts || summary.totalCouponDiscount || 0).toLocaleString('en-IN') %></p>
                        <p class="text-xs text-gray-500 mt-1">Promo checkout vouchers</p>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
                        <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Taxes & Shipping</p>
                        <p class="text-2xl font-bold text-gray-900 mt-2">+&#8377;<%= ((summary.tax || 0) + (summary.shipping || 0)).toLocaleString('en-IN') %></p>
                        <p class="text-xs text-gray-500 mt-1">Tax: &#8377;<%= (summary.tax || 0).toLocaleString('en-IN') %> &bull; Ship: &#8377;<%= (summary.shipping || 0).toLocaleString('en-IN') %></p>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
                        <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Payments Collected</p>
                        <p class="text-2xl font-bold text-blue-600 mt-2">&#8377;<%= (summary.collectedPayments || summary.totalCollectedRevenue || 0).toLocaleString('en-IN') %></p>
                        <p class="text-xs text-gray-500 mt-1">Gateway, wallet debits & COD</p>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
                        <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Purchase Refunds</p>
                        <p class="text-2xl font-bold text-rose-600 mt-2">-&#8377;<%= (summary.purchaseRefunds || summary.totalPurchaseRefunds || 0).toLocaleString('en-IN') %></p>
                        <p class="text-xs text-gray-500 mt-1">Cancellations & approved returns</p>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
                        <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Net Sales Recognized</p>
                        <p class="text-2xl font-bold text-emerald-600 mt-2">&#8377;<%= (summary.netSalesRecognized || 0).toLocaleString('en-IN') %></p>
                        <p class="text-xs text-gray-500 mt-1">Audited net recognized revenue</p>
                    </div>

                </div>

                <!-- Complete Financial Breakdown & Reconciliation Panel -->
                <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm mb-8">
                    <div class="px-6 py-5 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                        <div>
                            <h3 class="font-bold text-gray-900 text-base">Complete Financial Reconciliation & Breakdown</h3>
                            <p class="text-xs text-gray-400 mt-0.5">Audited breakdown of catalogue pricing, promotional deductions, taxes, authoritative collections, and net recognized revenue.</p>
                        </div>
                        <span class="text-xs px-3 py-1 bg-gray-100 rounded-full font-medium text-gray-600 self-start sm:self-auto">Order Placement Cohort</span>
                    </div>

                    <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6">

                        <!-- Column 1: Order Invoicing & Revenue Formation -->
                        <div class="bg-gray-50/70 p-5 rounded-xl border border-gray-100 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center gap-2 mb-4">
                                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                                    <h4 class="text-xs font-bold uppercase tracking-wider text-gray-700">1. Revenue Formation (Gross to Net)</h4>
                                </div>

                                <div class="space-y-2.5 text-xs">
                                    <div class="flex justify-between text-gray-600">
                                        <span>Merchandise Value (Catalogue)</span>
                                        <span class="font-semibold text-gray-900">&#8377;<%= (summary.merchandiseSales || summary.totalGrossAmount || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="flex justify-between text-amber-700">
                                        <span>Less: Promotional Offer Savings</span>
                                        <span class="font-semibold">-&#8377;<%= (summary.offerDiscounts || summary.totalOfferDiscount || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="flex justify-between text-amber-700">
                                        <span>Less: Coupon Discounts</span>
                                        <span class="font-semibold">-&#8377;<%= (summary.couponDiscounts || summary.totalCouponDiscount || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="flex justify-between text-gray-600">
                                        <span>Plus: Shipping Charges Collected</span>
                                        <span class="font-semibold text-gray-900">+&#8377;<%= (summary.shipping || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="flex justify-between text-gray-600">
                                        <span>Plus: Estimated GST / Tax (5%)</span>
                                        <span class="font-semibold text-gray-900">+&#8377;<%= (summary.tax || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="border-t border-gray-200 pt-2 flex justify-between font-semibold text-gray-800">
                                        <span>Gross Invoiced Amount</span>
                                        <span>&#8377;<%= ((summary.merchandiseSales || summary.totalGrossAmount || 0) - (summary.offerDiscounts || 0) - (summary.couponDiscounts || 0) + (summary.shipping || 0) + (summary.tax || 0)).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="flex justify-between text-rose-600">
                                        <span>Less: Returns & Cancellations</span>
                                        <span class="font-semibold">-&#8377;<%= (summary.cancellationsAndReturns || summary.totalRefundsOrCancellations || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                </div>
                            </div>

                            <div class="border-t border-gray-200 mt-4 pt-3 flex justify-between items-center">
                                <span class="text-xs font-bold text-gray-900 uppercase tracking-wider">Net Sales Recognized</span>
                                <span class="text-base font-bold text-emerald-600">&#8377;<%= (summary.netSalesRecognized || 0).toLocaleString('en-IN') %></span>
                            </div>
                        </div>

                        <!-- Column 2: Cash Flow & Authoritative Collections -->
                        <div class="bg-gray-50/70 p-5 rounded-xl border border-gray-100 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center gap-2 mb-4">
                                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                                    <h4 class="text-xs font-bold uppercase tracking-wider text-gray-700">2. Authoritative Collections & Cash</h4>
                                </div>

                                <div class="space-y-2.5 text-xs">
                                    <div class="flex justify-between text-gray-600">
                                        <span>Verified Payments Collected</span>
                                        <span class="font-semibold text-blue-700">&#8377;<%= (summary.collectedPayments || summary.totalCollectedRevenue || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="flex justify-between text-rose-600">
                                        <span>Less: Purchase Refunds Issued</span>
                                        <span class="font-semibold">-&#8377;<%= (summary.purchaseRefunds || summary.totalPurchaseRefunds || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="border-t border-gray-200 pt-2 flex justify-between font-semibold text-gray-900">
                                        <span>Net Purchase Receipts</span>
                                        <span class="text-blue-900 font-bold">&#8377;<%= (summary.netPurchaseReceipts != null ? summary.netPurchaseReceipts : ((summary.collectedPayments || 0) - (summary.purchaseRefunds || 0))).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="flex justify-between text-gray-500 pt-1">
                                        <span>Duplicate Multi-Captures Refunded</span>
                                        <span class="font-medium text-gray-700">&#8377;<%= (summary.duplicateRefunds || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="flex justify-between text-amber-700 pt-1">
                                        <span>Pending Cash-on-Delivery (COD)</span>
                                        <span class="font-medium">&#8377;<%= (summary.pendingCod || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="text-[11px] text-gray-400 italic pt-2">
                                        COD revenue recognized upon delivery; pending cash represents in-transit shipments.
                                    </div>
                                </div>
                            </div>

                            <div class="border-t border-gray-200 mt-4 pt-3 flex justify-between items-center">
                                <span class="text-xs font-bold text-gray-900 uppercase tracking-wider">Gross Cash Inflows</span>
                                <span class="text-base font-bold text-gray-900">&#8377;<%= (summary.grossCashCollections || (summary.collectedPayments || 0) + (summary.duplicateCollections || 0)).toLocaleString('en-IN') %></span>
                            </div>
                        </div>

                        <!-- Column 3: Audit & Integrity Verification -->
                        <div class="bg-gray-50/70 p-5 rounded-xl border border-gray-100 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center gap-2 mb-4">
                                    <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
                                    <h4 class="text-xs font-bold uppercase tracking-wider text-gray-700">3. Audit & Cohort Summary</h4>
                                </div>

                                <div class="space-y-2.5 text-xs">
                                    <div class="flex justify-between text-gray-600">
                                        <span>Reporting Cohort Basis</span>
                                        <span class="font-semibold text-gray-900">Order Placement</span>
                                    </div>
                                    <div class="flex justify-between text-gray-600">
                                        <span>Total Orders in Period</span>
                                        <span class="font-semibold text-gray-900"><%= (summary.ordersPlaced || summary.totalOrdersCount || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="flex justify-between text-gray-600">
                                        <span>Active Net Units Sold</span>
                                        <span class="font-semibold text-gray-900"><%= (summary.totalUnitsSold || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="flex justify-between text-gray-600">
                                        <span>Payment Evidence Integrity</span>
                                        <% if ((summary.ordersWithInsufficientEvidenceCount || 0) === 0) { %>
                                            <span class="font-semibold text-emerald-600">100% Audited</span>
                                        <% } else { %>
                                            <span class="font-semibold text-amber-600"><%= summary.ordersWithInsufficientEvidenceCount %> flagged</span>
                                        <% } %>
                                    </div>
                                    <div class="p-3 bg-white rounded-lg border border-gray-200 text-[11px] text-gray-500 leading-relaxed mt-2">
                                        Figures reflect lifetime verified gateway captures, confirmed wallet ledger debits, delivered cash receipts, and actual processed refunds for orders placed within the selected period.
                                    </div>
                                </div>
                            </div>

                            <div class="border-t border-gray-200 mt-4 pt-3 flex justify-between items-center text-xs text-gray-500">
                                <span>Period: <%= startDate %> to <%= endDate %></span>
                                <span class="font-semibold text-gray-700">IST (+5:30)</span>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Orders Table -->
                <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm">
                    <div class="p-6 border-b border-gray-100 flex justify-between items-center">
                        <div>
                            <h3 class="font-bold text-gray-900 text-base">Orders Included in Report</h3>
                            <p class="text-xs text-gray-400 mt-0.5">Individual transaction audit showing item merchandise value, discounts, taxes, and collected amounts.</p>
                        </div>
                        <span class="text-xs text-gray-500">Showing page <%= currentPage %> of <%= totalPages %></span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-400 uppercase tracking-widest text-left">
                                <tr>
                                    <th class="px-6 py-4 font-medium">Order Number</th>
                                    <th class="px-6 py-4 font-medium">Date</th>
                                    <th class="px-6 py-4 font-medium">Customer</th>
                                    <th class="px-6 py-4 font-medium">Payment</th>
                                    <th class="px-6 py-4 font-medium">Status</th>
                                    <th class="px-6 py-4 font-medium text-right">Gross</th>
                                    <th class="px-6 py-4 font-medium text-right">Discounts</th>
                                    <th class="px-6 py-4 font-medium text-right">Collected</th>
                                    <th class="px-6 py-4 font-medium text-right">Refunded</th>
                                    <th class="px-6 py-4 font-medium text-right">Net Payable</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                <% if (!orders || orders.length === 0) { %>
                                    <tr>
                                        <td colspan="10" class="px-6 py-12 text-center text-gray-400 text-sm">
                                            No orders placed within this date range.
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% orders.forEach((ord) => { %>
                                        <tr class="hover:bg-gray-50 transition">
                                            <td class="px-6 py-4 font-semibold text-gray-900">
                                                <a href="/admin/orders/<%= ord._id %>" class="hover:underline">
                                                    <%= ord.orderNumber %>
                                                </a>
                                            </td>
                                            <td class="px-6 py-4 text-gray-600 whitespace-nowrap">
                                                <%= new Date(ord.placedAt).toLocaleDateString('en-IN', { month: 'short', day: '2-digit', year: 'numeric' }) %>
                                            </td>
                                            <td class="px-6 py-4">
                                                <p class="font-medium text-gray-900"><%= ord.customerName %></p>
                                                <p class="text-xs text-gray-400"><%= ord.customerEmail %></p>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="flex items-center gap-1.5">
                                                    <span class="text-xs font-semibold px-2 py-0.5 rounded bg-gray-100 text-gray-700">
                                                        <%= ord.paymentMethod %>
                                                    </span>
                                                    <% if (ord.paymentStatus === 'COMPLETED') { %>
                                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" title="Payment Completed"></span>
                                                    <% } else if (ord.paymentStatus === 'REFUNDED' || ord.paymentStatus === 'PARTIALLY_REFUNDED') { %>
                                                        <span class="w-1.5 h-1.5 rounded-full bg-purple-500" title="Payment Refunded"></span>
                                                    <% } else { %>
                                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500" title="<%= ord.paymentStatus %>"></span>
                                                    <% } %>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <span class="text-xs font-semibold px-2 py-0.5 rounded <%= ord.orderStatus === 'DELIVERED' ? 'bg-emerald-100 text-emerald-800' : (ord.orderStatus === 'CANCELLED' ? 'bg-red-100 text-red-800' : 'bg-blue-100 text-blue-800') %>">
                                                    <%= ord.orderStatus.replace(/_/g, " ") %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-right text-gray-700">&#8377;<%= (ord.grossAmount || 0).toLocaleString('en-IN') %></td>
                                            <td class="px-6 py-4 text-right text-amber-600 whitespace-nowrap">
                                                <% const totDisc = (ord.offerDiscount || 0) + (ord.couponDiscount || 0); %>
                                                <% if (totDisc > 0) { %>
                                                    -&#8377;<%= totDisc.toLocaleString('en-IN') %>
                                                    <span class="block text-[10px] text-gray-400">
                                                        <% if (ord.offerDiscount > 0) { %>Off: &#8377;<%= ord.offerDiscount %><% } %>
                                                        <% if (ord.couponDiscount > 0) { %> Coup: &#8377;<%= ord.couponDiscount %><% } %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="text-gray-400">&#8377;0</span>
                                                <% } %>
                                            </td>
                                            <td class="px-6 py-4 text-right font-medium text-blue-700">&#8377;<%= (ord.purchaseCollected || 0).toLocaleString('en-IN') %></td>
                                            <td class="px-6 py-4 text-right text-rose-600">
                                                <% if ((ord.purchaseRefund || 0) > 0) { %>
                                                    -&#8377;<%= ord.purchaseRefund.toLocaleString('en-IN') %>
                                                <% } else { %>
                                                    <span class="text-gray-400">&#8377;0</span>
                                                <% } %>
                                            </td>
                                            <td class="px-6 py-4 text-right font-bold text-gray-900">&#8377;<%= (ord.netPayable || 0).toLocaleString('en-IN') %></td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (totalPages > 1) { %>
                        <div class="px-6 py-4 border-t border-gray-100 flex justify-between items-center text-sm">
                            <% if (currentPage > 1) { %>
                                <a href="/admin/sales-report?rangeType=<%= rangeType %>&startDate=<%= startDate %>&endDate=<%= endDate %>&page=<%= currentPage - 1 %>"
                                    class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">
                                    &larr; Previous
                                </a>
                            <% } else { %>
                                <div></div>
                            <% } %>

                            <span class="text-gray-500">Page <%= currentPage %> of <%= totalPages %></span>

                            <% if (currentPage < totalPages) { %>
                                <a href="/admin/sales-report?rangeType=<%= rangeType %>&startDate=<%= startDate %>&endDate=<%= endDate %>&page=<%= currentPage + 1 %>"
                                    class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">
                                    Next &rarr;
                                </a>
                            <% } else { %>
                                <div></div>
                            <% } %>
                        </div>
                    <% } %>

                </div>

            </main>

        </div>

    </div>

    <script>
        function toggleCustomDates() {
            const select = document.getElementById("rangeTypeSelect");
            const fields = document.getElementById("customDateFields");
            if (select.value === "custom") {
                fields.classList.remove("hidden");
                fields.classList.add("flex");
            } else {
                fields.classList.add("hidden");
                fields.classList.remove("flex");
            }
        }
    </script>
</body>
</html>
