<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VELORA Admin - Category Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#FAFAF8]">

    <div class="flex">

        <%- include("partials/sidebar", { active: "categories" }) %>

        <div class="flex-1 min-w-0">

            <%- include("partials/topbar") %>

            <main class="px-8 py-8 max-w-6xl">

                <p class="text-xs text-gray-400 uppercase tracking-widest mb-2">Admin / Categories</p>

                <div class="flex justify-between items-start mb-8">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-900">Category Management</h1>
                        <p class="text-gray-500 mt-1">Organize your product catalog into browsable categories.</p>
                    </div>

                    <button
                        type="button"
                        onclick="document.getElementById('categoryModal').classList.remove('hidden')"
                        class="h-11 px-5 bg-black text-white rounded-lg text-sm font-semibold"
                    >
                        + New Category
                    </button>
                </div>

                <% if (error) { %>
                    <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-600 rounded-xl text-sm">
                        <%= error %>
                    </div>
                <% } %>

                <!-- Stat cards -->
                <div class="grid grid-cols-2 gap-4 mb-6 max-w-md">
                    <div class="bg-white p-5 rounded-xl border border-gray-200">
                        <p class="text-xs text-gray-400 uppercase tracking-widest">Total Categories</p>
                        <p class="text-2xl font-bold mt-1"><%= totalCategories %></p>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-gray-200">
                        <p class="text-xs text-gray-400 uppercase tracking-widest">Showing</p>
                        <p class="text-2xl font-bold mt-1">Page <%= currentPage %> of <%= totalPages || 1 %></p>
                    </div>
                </div>

                <!-- Search -->
                <div class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
                    <form action="/admin/categories" method="GET" class="flex gap-3">
                        <input
                            type="text"
                            name="search"
                            value="<%= search %>"
                            placeholder="Search categories by name..."
                            class="flex-1 border border-gray-300 rounded-lg px-4 py-3 outline-none focus:border-black"
                        >
                        <button type="submit" class="h-[46px] px-6 bg-black text-white rounded-lg">Search</button>
                        <% if (search) { %>
                            <a href="/admin/categories" class="h-[46px] px-6 border border-gray-300 rounded-lg flex items-center text-sm">Clear</a>
                        <% } %>
                    </form>
                </div>

                <!-- Table -->
                <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr class="text-left text-xs text-gray-400 uppercase tracking-widest">
                                <th class="px-6 py-4 font-medium">Category Name</th>
                                <th class="px-6 py-4 font-medium">Status</th>
                                <th class="px-6 py-4 font-medium">Last Modified</th>
                                <th class="px-6 py-4 font-medium text-right">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (categories.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center py-14 text-gray-400">No categories found</td>
                                </tr>
                            <% } %>

                            <% categories.forEach(cat => {
                                const lastModified = new Date(cat.updatedAt).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
                            %>
                                <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50">
                                    <td class="px-6 py-4">
                                        <p class="font-semibold text-gray-900"><%= cat.name %></p>
                                        <p class="text-xs text-gray-400"><%= cat.slug %></p>
                                    </td>

                                    <td class="px-6 py-4">
                                        <form action="/admin/categories/<%= cat._id %>/toggle-status" method="POST" onsubmit="return confirm('Change status of this category?')">
                                            <input type="hidden" name="search" value="<%= search %>">
                                            <input type="hidden" name="page" value="<%= currentPage %>">
                                            <button type="submit" class="relative inline-flex h-6 w-11 items-center rounded-full transition <%= cat.isActive ? 'bg-black' : 'bg-gray-300' %>">
                                                <span class="inline-block h-4 w-4 transform rounded-full bg-white transition <%= cat.isActive ? 'translate-x-6' : 'translate-x-1' %>"></span>
                                            </button>
                                        </form>
                                    </td>

                                    <td class="px-6 py-4 text-gray-600"><%= lastModified %></td>

                                    <td class="px-6 py-4">
                                        <div class="flex justify-end gap-3">
                                            <a href="/admin/categories?edit=<%= cat._id %>" title="Edit" class="text-gray-500 hover:text-black">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                                            </a>
                                            <form action="/admin/categories/<%= cat._id %>/delete" method="POST" onsubmit="return confirm('Delete this category? Products in it will need to be reassigned.')">
                                                <input type="hidden" name="search" value="<%= search %>">
                                                <input type="hidden" name="page" value="<%= currentPage %>">
                                                <button type="submit" title="Delete" class="text-gray-500 hover:text-red-600">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>

                    <% if (totalPages > 1) { %>
                        <div class="flex justify-between items-center px-6 py-4 border-t border-gray-200 text-sm text-gray-500">
                            <p>Showing page <%= currentPage %> of <%= totalPages %></p>
                            <div class="flex gap-2">
                                <% for (let i = 1; i <= totalPages; i++) { %>
                                    <a
                                        href="/admin/categories?page=<%= i %>&search=<%= encodeURIComponent(search) %>"
                                        class="w-8 h-8 flex items-center justify-center rounded-lg border text-xs
                                            <%= currentPage === i ? 'bg-black text-white border-black' : 'bg-white text-black border-gray-200' %>"
                                    >
                                        <%= i %>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>

            </main>
        </div>
    </div>

    <!-- Add / Edit Category Modal -->
    <div id="categoryModal" class="<%= editCategory ? '' : 'hidden' %> fixed inset-0 bg-black/40 flex items-center justify-center z-50 px-4">
        <div class="bg-white rounded-2xl w-full max-w-md p-6">

            <div class="flex justify-between items-center mb-6">
                <h2 class="text-lg font-bold"><%= editCategory ? "Edit Category" : "Add New Category" %></h2>
                <a href="/admin/categories" class="text-gray-400 hover:text-black text-xl leading-none">&times;</a>
            </div>

            <form action="<%= editCategory ? '/admin/categories/' + editCategory._id + '/edit' : '/admin/categories' %>" method="POST" class="space-y-5">

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-widest text-gray-500 mb-2">Category Name</label>
                    <input
                        type="text"
                        name="name"
                        value="<%= editCategory ? editCategory.name : '' %>"
                        placeholder="e.g. Footwear"
                        required
                        class="w-full border border-gray-300 rounded-lg px-4 py-3 outline-none focus:border-black"
                    >
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-widest text-gray-500 mb-2">Status</label>
                    <div class="flex gap-6">
                        <label class="flex items-center gap-2 text-sm">
                            <input type="radio" name="status" value="active" <%= (!editCategory || editCategory.isActive) ? 'checked' : '' %>>
                            Active
                        </label>
                        <label class="flex items-center gap-2 text-sm">
                            <input type="radio" name="status" value="inactive" <%= (editCategory && !editCategory.isActive) ? 'checked' : '' %>>
                            Inactive
                        </label>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-2">
                    <a href="/admin/categories" class="px-5 py-3 border border-gray-300 rounded-lg text-sm">Cancel</a>
                    <button type="submit" class="px-5 py-3 bg-black text-white rounded-lg text-sm font-semibold">
                        <%= editCategory ? "Save Changes" : "Create Category" %>
                    </button>
                </div>
            </form>
        </div>
    </div>

</body>
</html>
