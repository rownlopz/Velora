<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile | VELORA</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-[#FAFAF8] flex flex-col min-h-screen">

<%- include("../partials/storeHeader") %>

<main class="flex-1">
    <div class="max-w-screen-lg mx-auto px-6 md:px-10 py-14">

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="mb-8 p-4 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl text-sm text-center">
                <%= success %>
            </div>
        <% } %>

        <!-- Welcome banner -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 mb-12">
            <div class="flex items-center gap-6">
                <div class="relative shrink-0">
                    <div class="w-24 h-24 rounded-full bg-gray-200 overflow-hidden flex items-center justify-center text-3xl font-semibold text-gray-500">
                        <% if (user.avatar) { %>
                            <img src="<%= user.avatar %>" alt="Profile photo" class="w-full h-full object-cover">
                        <% } else { %>
                            <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : "U" %>
                        <% } %>
                    </div>
                    <a href="/profile/edit" class="absolute bottom-0 right-0 w-8 h-8 bg-black rounded-full flex items-center justify-center text-white">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    </a>
                </div>

                <div>
                    <h1 class="text-4xl font-medium leading-tight">
                        Welcome,<br><%= user.fullName ? user.fullName.split(" ")[0] : "there" %>
                    </h1>
                    <p class="text-gray-400 text-sm mt-2">Joined <%= joinedYear %></p>
                </div>
            </div>

            <div class="flex gap-3 shrink-0">
                <a href="/profile/edit" class="h-12 px-6 leading-[2.9rem] bg-black text-white rounded-xl text-sm font-semibold text-center">
                    Edit Profile
                </a>
                <a href="/logout" class="h-12 px-6 leading-[2.9rem] border border-gray-300 rounded-xl text-sm font-semibold text-center hover:bg-gray-50 transition">
                    Sign Out
                </a>
                <span class="h-12 px-6 leading-[2.9rem] border border-gray-300 rounded-xl text-sm font-semibold text-center text-gray-400 cursor-not-allowed" title="Coming soon">
                    View Wallet
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <!-- Account Details -->
            <div class="bg-white border border-gray-200 rounded-2xl p-8">
                <p class="text-xs font-semibold uppercase tracking-widest border-b border-gray-200 pb-4">Account Details</p>

                <div class="mt-6 space-y-5">
                    <div>
                        <p class="text-[11px] text-gray-400 uppercase tracking-widest">Full Name</p>
                        <p class="mt-1"><%= user.fullName %></p>
                    </div>
                    <div>
                        <p class="text-[11px] text-gray-400 uppercase tracking-widest">Email Address</p>
                        <p class="mt-1"><%= user.email %></p>
                    </div>
                    <div>
                        <p class="text-[11px] text-gray-400 uppercase tracking-widest">Default Address</p>
                        <% if (defaultAddress) { %>
                            <p class="mt-1"><%= defaultAddress.addressLine1 %>, <%= defaultAddress.city %></p>
                        <% } else { %>
                            <p class="mt-1 text-gray-400">No address saved — <a href="/addresses/add" class="underline">add one</a></p>
                        <% } %>
                    </div>
                    <div>
                        <p class="text-[11px] text-gray-400 uppercase tracking-widest">Phone Number</p>
                        <p class="mt-1"><%= user.phone || "Not added" %></p>
                    </div>
                </div>
            </div>

            <!-- Recent Orders -->
            <div class="bg-white border border-gray-200 rounded-2xl p-8">
                <div class="flex justify-between items-center border-b border-gray-200 pb-4">
                    <p class="text-xs font-semibold uppercase tracking-widest">Recent Orders</p>
                    <span class="text-xs text-gray-300 cursor-not-allowed" title="Coming soon">View All History &rarr;</span>
                </div>

                <div class="mt-8 flex flex-col items-center justify-center text-center py-6">
                    <p class="text-gray-400 text-sm">You haven't placed any orders yet.</p>
                    <span class="mt-4 text-xs font-semibold uppercase tracking-widest text-gray-300 cursor-not-allowed" title="Coming soon">Start Shopping</span>
                </div>
            </div>

            <!-- Wishlist -->
            <div class="bg-white border border-gray-200 rounded-2xl p-8">
                <p class="text-xs font-semibold uppercase tracking-widest">Your Wishlist</p>
                <p class="text-gray-400 text-sm mt-4">Nothing saved yet.</p>
                <span class="inline-block mt-4 text-xs font-semibold uppercase tracking-widest underline text-gray-300 cursor-not-allowed" title="Coming soon">Manage Wishlist</span>
            </div>

            <!-- Addresses quick link -->
            <div class="bg-white border border-gray-200 rounded-2xl p-8">
                <p class="text-xs font-semibold uppercase tracking-widest">Saved Addresses</p>
                <p class="text-gray-500 text-sm mt-4">Manage your delivery addresses.</p>
                <a href="/addresses" class="inline-block mt-4 h-11 px-6 leading-[2.6rem] bg-black text-white rounded-xl text-xs font-semibold uppercase tracking-widest">
                    Manage Addresses
                </a>
            </div>
        </div>
    </div>
</main>

<%- include("../partials/storeFooter") %>

</body>
</html>
