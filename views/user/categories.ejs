<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories | VELORA</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-[#FAFAF8] flex flex-col min-h-screen">

<%- include("../partials/storeHeader") %>

<main class="flex-1">
    <div class="max-w-screen-xl mx-auto px-6 md:px-10 py-10">
        
        <p class="text-xs text-gray-400 mb-6 uppercase tracking-widest">
            <a href="/" class="hover:text-black">Home</a> &nbsp;/&nbsp; <span class="text-gray-600">Shop by Category</span>
        </p>

        <h1 class="text-4xl md:text-5xl font-light text-gray-900 mb-4">Categories</h1>
        <p class="text-gray-500 mb-12 max-w-2xl text-lg">Explore our curated range of essentials, crafted for the modern silhouette.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
            <% categories.forEach(cat => { %>
                <a href="/products?category=<%= cat.slug %>" class="group relative block aspect-[4/5] bg-gray-100 overflow-hidden">
                    <img src="<%= cat.image %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" alt="<%= cat.name %>">
                    <div class="absolute inset-0 bg-black/10 transition-colors group-hover:bg-black/20"></div>
                    <div class="absolute inset-0 flex items-center justify-center">
                        <span class="bg-white px-8 py-3 text-xs font-semibold uppercase tracking-widest text-black shadow-lg">
                            <%= cat.name %>
                        </span>
                    </div>
                </a>
            <% }) %>
        </div>

    </div>
</main>

<%- include("../partials/storeFooter") %>

</body>
</html>
