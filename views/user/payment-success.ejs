<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Successful | VELORA</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-[#FAFAF8] flex flex-col min-h-screen">

<%- include("../partials/storeHeader", { active: "" }) %>

<main class="flex-1 flex items-center justify-center py-16 px-6">
    <div class="max-w-xl w-full bg-white border border-gray-200 rounded-3xl p-8 md:p-12 text-center shadow-sm">

        <!-- Payment Success Illustration -->
        <div class="w-20 h-20 mx-auto rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 mb-6 border border-emerald-200">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5"/>
            </svg>
        </div>

        <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 text-[11px] font-semibold uppercase tracking-widest rounded-full mb-3">
            Payment Verified & Confirmed
        </span>

        <h1 class="text-3xl font-medium text-gray-900 tracking-tight">
            Payment Successful!
        </h1>

        <p class="text-gray-500 text-sm mt-3 leading-relaxed">
            Your online payment has been securely verified and captured. Your order is now confirmed and being prepared for shipment.
        </p>

        <!-- Payment Statement Card -->
        <div class="bg-gray-50 border border-gray-100 rounded-2xl p-5 my-8 text-left space-y-3">
            <div class="flex justify-between items-center text-xs pb-3 border-b border-gray-200/60">
                <span class="text-gray-500 uppercase tracking-wider font-semibold">Order Number</span>
                <span class="font-mono font-bold text-gray-900 text-sm"><%= order.orderNumber %></span>
            </div>

            <% if (order.razorpayPaymentId) { %>
                <div class="flex justify-between items-center text-xs pb-3 border-b border-gray-200/60">
                    <span class="text-gray-500 uppercase tracking-wider font-semibold">Payment ID</span>
                    <span class="font-mono text-gray-700 text-xs"><%= order.razorpayPaymentId %></span>
                </div>
            <% } %>

            <div class="flex justify-between items-center text-xs pb-3 border-b border-gray-200/60">
                <span class="text-gray-500 uppercase tracking-wider font-semibold">Payment Method</span>
                <span class="font-medium text-gray-900"><%= order.paymentMethod === 'ONLINE' ? 'Razorpay Online Payment' : (order.paymentMethod === 'WALLET' ? 'Velora Wallet' : 'Cash on Delivery') %></span>
            </div>

            <div class="flex justify-between items-center text-xs pb-3 border-b border-gray-200/60">
                <span class="text-gray-500 uppercase tracking-wider font-semibold">Deliver To</span>
                <span class="font-medium text-gray-900 text-right truncate max-w-[220px]">
                    <%= order.shippingAddress.firstName %> <%= order.shippingAddress.lastName %>, <%= order.shippingAddress.city %>
                </span>
            </div>

            <div class="flex justify-between items-center text-xs pt-1">
                <span class="text-gray-500 uppercase tracking-wider font-semibold">Amount Paid</span>
                <span class="text-base font-bold text-emerald-700">&#8377;<%= order.pricing.totalAmount.toLocaleString('en-IN') %></span>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/orders/<%= order._id %>"
                class="flex-1 py-4 px-6 bg-black text-white text-xs font-semibold uppercase tracking-widest rounded-xl hover:bg-gray-800 transition">
                View Order Details
            </a>
            <a href="/products"
                class="flex-1 py-4 px-6 border border-gray-300 text-gray-800 text-xs font-semibold uppercase tracking-widest rounded-xl hover:border-black hover:text-black transition">
                Continue Shopping
            </a>
        </div>

    </div>
</main>

<%- include("../partials/storeFooter") %>

</body>
</html>
