<%- include("../partials/authHeader",{title:"OTP Verification"}) %>

<main class="flex-1 flex items-center justify-center py-16">

    <div class="auth-card">

        <!-- Lock Icon -->

        <div class="flex justify-center">
            <div class="w-20 h-20 rounded-full bg-gray-100 flex items-center justify-center text-3xl">
                🔒
            </div>
        </div>

        <!-- Heading -->

        <h2 class="text-4xl font-medium text-center mt-6">
            Verification Required
        </h2>

        <p class="text-center text-gray-500 mt-4 leading-7">
            We've sent a 4-digit code to
            <br>
            <span class="font-medium">
                rowanlopez@gmail.com
            </span>
        </p>

        <!-- OTP -->

        <form class="mt-10">
            <div class="flex justify-center gap-4">
                <input
                    maxlength="1"
                    class="w-16 h-16 border rounded-xl text-center text-2xl focus:border-black outline-none">
                <input
                    maxlength="1"
                    class="w-16 h-16 border rounded-xl text-center text-2xl focus:border-black outline-none">
                <input
                    maxlength="1"
                    class="w-16 h-16 border rounded-xl text-center text-2xl focus:border-black outline-none">
                <input
                    maxlength="1"
                    class="w-16 h-16 border rounded-xl text-center text-2xl focus:border-black outline-none">
            </div>
            <button
                class="primary-btn mt-10">
                VERIFY CODE
            </button>

        </form>
        <p class="text-center mt-8 text-gray-500">
            Didn't receive the code?
        </p>

        <button
            class="block mx-auto mt-2 text-black font-semibold">
            Resend Code
        </button>

        <p class="text-center text-gray-400 text-sm mt-2">
            01:00
        </p>
        
        <a
            href="/signup"
            class="block text-center mt-6 text-gray-500 hover:text-black">
            Change email address
        </a>
    </div>
</main>

<%- include("../partials/authFooter") %>