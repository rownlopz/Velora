<%- include("../partials/authHeader",{title:"Forgot Password"}) %>

<main class="flex-1 flex items-center justify-center py-16">
    <div class="auth-card">
        <h2 class="text-5xl font-medium text-center">
            Forgot Password?
        </h2>

        <p class="text-center text-gray-500 mt-5">
            Enter your email address and we'll send
            you a link to reset your password.
        </p>

        <form
            action="/forgot-password"
            method="POST"
            class="mt-10 space-y-6">

            <div>
                <label class="auth-label">
                    Email Address
                </label>

                <input
                    type="email"
                    name="email"
                    class="auth-input"
                    placeholder="Enter your email">
            </div>

            <button class="primary-btn">
                SEND RESET LINK
            </button>

        </form>

        <div class="border-t border-gray-200 mt-8 pt-6">
            <a
                href="/login"
                class="block text-center font-medium hover:underline">
                ← Back to Login
            </a>
        </div>
    </div>
</main>

<%- include("../partials/authFooter") %>