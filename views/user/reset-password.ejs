<%- include("../partials/authHeader", { title: "Reset Password" }) %>

<main class="flex-1 flex items-center justify-center py-16">

    <div class="auth-card max-w-lg">

        <h2 class="text-4xl font-medium text-center">
            Reset Password
        </h2>
        <p class="text-center text-gray-500 mt-4">
            Create a new password for your account.
        </p>
        <form action="/reset-password" method="POST" class="mt-10 space-y-6">
            <div>
                <label class="auth-label">
                    New Password
                </label>

                <div class="relative">
                    <input
                        type="password"
                        name="password"
                        class="auth-input pr-12"
                        placeholder="Enter new password">
                    <button
                        type="button"
                        class="absolute right-4 top-1/2 -translate-y-1/2">
                        👁
                    </button>

                </div>
            </div>

            <div>
                <label class="auth-label">
                    Confirm New Password
                </label>

                <div class="relative">
                    <input
                        type="password"
                        name="confirmPassword"
                        class="auth-input pr-12"
                        placeholder="Confirm password">
                    <button
                        type="button"
                        class="absolute right-4 top-1/2 -translate-y-1/2">
                        👁
                    </button>
                </div>
            </div>

            <div class="space-y-2 text-sm text-gray-500">

                <p>✓ At least 8 characters</p>
                <p>✓ At least one special character</p>

            </div>
            <button class="primary-btn">
                RESET PASSWORD
            </button>
        </form>
        <div class="text-center mt-8">
            <a
                href="/login"
                class="text-gray-500 hover:text-black">
                Back to Login
            </a>
        </div>
    </div>
</main>

<%- include("../partials/authFooter") %>