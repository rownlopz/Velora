<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Collections | VELORA</title>
    <link rel="stylesheet" href="/css/output.css">
    <style>
        .wishlist-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 10;
            width: 36px;
            height: 36px;
            border-radius: 9999px;
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(0, 0, 0, 0.06);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4b5563;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
        }
        .wishlist-btn:hover {
            background: #ffffff;
            transform: scale(1.12);
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
            color: #ef4444;
        }
        .wishlist-btn:active {
            transform: scale(0.92);
        }
        .wishlist-btn.active {
            color: #ef4444;
            background: #ffffff;
        }
    </style>
</head>
<body class="bg-[#FAFAF8] flex flex-col min-h-screen">

<%- include("../partials/storeHeader", { active: "products" }) %>

<%
    function buildQuery(overrides) {
        const params = {
            search: filters.search,
            category: Array.isArray(filters.categories) && filters.categories.length > 0 ? filters.categories.join(',') : '',
            size: Array.isArray(filters.sizes) && filters.sizes.length > 0 ? filters.sizes.join(',') : '',
            color: Array.isArray(filters.colors) && filters.colors.length > 0 ? filters.colors.join(',') : '',
            minPrice: filters.minPrice !== undefined ? filters.minPrice : '',
            maxPrice: filters.maxPrice !== undefined ? filters.maxPrice : '',
            sort: filters.sort,
            page: filters.page,
            ...overrides,
        };
        const qs = Object.entries(params)
            .filter(([, v]) => v !== '' && v !== undefined && v !== null)
            .map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v))
            .join('&');
        return '/products?' + qs;
    }
%>

<main class="flex-1">
    <div class="max-w-screen-xl mx-auto px-6 md:px-10 py-10">

        <h1 class="text-3xl font-medium">
            <%= filters.search ? 'Search Results' : 'All Products' %>
        </h1>

        <% if (typeof notice !== 'undefined' && notice) { %>
            <div class="mt-4 p-4 bg-amber-50 border border-amber-200 text-amber-700 rounded-xl text-sm">
                <%= notice %>
            </div>
        <% } %>

        <p class="text-gray-400 text-sm mt-1">
            <% if (filters.search) { %>
                Showing <%= totalProducts %> results for "<%= filters.search %>"
            <% } else { %>
                Showing <%= totalProducts %> products
            <% } %>
        </p>

        <div class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-10 mt-8">

            <!-- Filters sidebar -->
            <aside>
                <form action="/products" method="GET" class="space-y-8" id="filterForm">
                    <input type="hidden" name="sort" value="<%= filters.sort %>">

                    <!-- Search -->
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-widest text-gray-900 mb-3">Search</label>
                        <div class="flex gap-2">
                            <input type="text" name="search" id="searchInput"
                                value="<%= filters.search %>"
                                placeholder="Search products..."
                                class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm outline-none focus:border-black bg-gray-50">
                            <button type="submit" class="px-3 py-2 bg-black text-white text-xs rounded-md shrink-0">Go</button>
                        </div>
                    </div>

                    <!-- Category -->
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-widest text-gray-900 mb-3">Category</p>
                        <ul class="space-y-3 text-sm">
                            <% categories.forEach(cat => { %>
                                <li>
                                    <label class="flex items-center gap-3 cursor-pointer group">
                                        <div class="relative flex items-center justify-center w-4 h-4 border border-gray-300 rounded-sm bg-white group-hover:border-black">
                                            <input type="checkbox" name="category" value="<%= cat.slug %>" class="peer sr-only"
                                                <%= (filters.categories || []).includes(cat.slug) ? 'checked' : '' %>
                                                onchange="document.getElementById('filterForm').submit()">
                                            <svg class="hidden peer-checked:block w-3 h-3 text-black pointer-events-none" viewBox="0 0 14 14" fill="none">
                                                <path d="M3 7.5L5.5 10L11 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </div>
                                        <span class="text-gray-600 group-hover:text-black transition-colors"><%= cat.name %></span>
                                    </label>
                                </li>
                            <% }) %>
                        </ul>
                    </div>

                    <!-- Size -->
                    <% if (availableSizes && availableSizes.length > 0) { %>
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-widest text-gray-900 mb-3">Size</p>
                        <div class="flex flex-wrap gap-2">
                            <% availableSizes.forEach(s => { %>
                                <label class="cursor-pointer">
                                    <input type="checkbox" name="size" value="<%= s %>" class="peer sr-only"
                                        <%= (filters.sizes || []).includes(s) ? 'checked' : '' %>
                                        onchange="document.getElementById('filterForm').submit()">
                                    <div class="flex items-center justify-center min-w-[36px] h-[36px] px-2 border border-gray-200 bg-white text-xs text-gray-600 rounded-md peer-checked:bg-black peer-checked:text-white peer-checked:border-black hover:border-black transition-colors">
                                        <%= s %>
                                    </div>
                                </label>
                            <% }) %>
                        </div>
                    </div>
                    <% } %>

                    <!-- Color — simple text pills, no swatches -->
                    <% if (availableColors && availableColors.length > 0) { %>
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-widest text-gray-900 mb-3">Color</p>
                        <div class="flex flex-wrap gap-2">
                            <% availableColors.forEach(c => {
                                const isChecked = (filters.colors || []).some(fc => fc.toLowerCase() === c.toLowerCase());
                            %>
                                <label class="cursor-pointer">
                                    <input type="checkbox" name="color" value="<%= c %>" class="peer sr-only"
                                        <%= isChecked ? 'checked' : '' %>
                                        onchange="document.getElementById('filterForm').submit()">
                                    <span class="inline-block px-3 py-1 text-sm border border-gray-200 rounded-md text-gray-600 bg-white peer-checked:border-black peer-checked:text-black peer-checked:font-medium hover:border-black transition-colors cursor-pointer">
                                        <%= c %>
                                    </span>
                                </label>
                            <% }) %>
                        </div>
                    </div>
                    <% } %>

                    <!-- Price -->
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-widest text-gray-900 mb-3">Price Range</p>
                        <div class="flex items-center gap-2">
                            <input type="number" name="minPrice"
                                value="<%= filters.minPrice !== undefined ? filters.minPrice : '' %>"
                                placeholder="₹0" min="0"
                                class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm outline-none focus:border-black bg-gray-50"
                                onblur="document.getElementById('filterForm').submit()">
                            <span class="text-gray-300">&ndash;</span>
                            <input type="number" name="maxPrice"
                                value="<%= filters.maxPrice !== undefined ? filters.maxPrice : '' %>"
                                placeholder="₹<%= priceMax || 1000 %>" min="0"
                                class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm outline-none focus:border-black bg-gray-50"
                                onblur="document.getElementById('filterForm').submit()">
                        </div>
                    </div>

                    <% if (filters.search || (filters.categories && filters.categories.length) || (filters.sizes && filters.sizes.length) || (filters.colors && filters.colors.length) || filters.minPrice !== undefined || filters.maxPrice !== undefined) { %>
                        <a href="/products" class="block text-center text-xs font-semibold uppercase tracking-widest underline text-gray-400 mt-4">
                            Clear All Filters
                        </a>
                    <% } %>
                </form>
            </aside>

            <!-- Results -->
            <div>
                <div class="flex justify-end mb-6">
                    <form action="/products" method="GET">
                        <input type="hidden" name="search" value="<%= filters.search %>">
                        <% (filters.categories || []).forEach(c => { %><input type="hidden" name="category" value="<%= c %>"><% }) %>
                        <% (filters.sizes || []).forEach(s => { %><input type="hidden" name="size" value="<%= s %>"><% }) %>
                        <% (filters.colors || []).forEach(c => { %><input type="hidden" name="color" value="<%= c %>"><% }) %>
                        <input type="hidden" name="minPrice" value="<%= filters.minPrice !== undefined ? filters.minPrice : '' %>">
                        <input type="hidden" name="maxPrice" value="<%= filters.maxPrice !== undefined ? filters.maxPrice : '' %>">
                        <select name="sort" onchange="this.form.submit()" class="border border-gray-200 rounded-md px-4 py-2 text-sm outline-none focus:border-black bg-white">
                            <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest</option>
                            <option value="price-asc" <%= filters.sort === 'price-asc' ? 'selected' : '' %>>Price: Low to High</option>
                            <option value="price-desc" <%= filters.sort === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
                            <option value="name-asc" <%= filters.sort === 'name-asc' ? 'selected' : '' %>>Name: A to Z</option>
                            <option value="name-desc" <%= filters.sort === 'name-desc' ? 'selected' : '' %>>Name: Z to A</option>
                        </select>
                    </form>
                </div>

                <% if (products.length === 0) { %>
                    <div class="text-center py-24 text-gray-400">
                        <p>No products match these filters.</p>
                        <a href="/products" class="underline text-sm mt-2 inline-block">Clear filters</a>
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                        <% products.forEach(p => { 
                            const pVariantIds = (p.variantIds || []).map(v => v.toString());
                            const userWishlist = typeof wishlistVariantIds !== 'undefined' ? wishlistVariantIds : [];
                            const inWishlist = pVariantIds.some(vid => userWishlist.includes(vid));
                            const activeVariantId = inWishlist 
                                ? pVariantIds.find(vid => userWishlist.includes(vid)) 
                                : (p.defaultVariantId ? p.defaultVariantId.toString() : '');
                        %>
                            <div class="group relative flex flex-col">
                                <div class="aspect-[3/4] bg-gray-100 overflow-hidden mb-3 relative">
                                    <a href="/products/<%= p.slug %>" class="block w-full h-full">
                                        <% if (p.thumbnail) { %>
                                            <img src="<%= p.thumbnail %>" alt="<%= p.name %>"
                                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 <%= p.isUnavailable ? 'opacity-60' : '' %>">
                                        <% } %>
                                        <% if (p.isUnavailable) { %>
                                            <div class="absolute inset-0 flex items-end justify-center pb-4">
                                                <span class="bg-black/70 text-white text-[10px] px-3 py-1 uppercase tracking-widest rounded-full backdrop-blur-sm">Unavailable</span>
                                            </div>
                                        <% } else if (p.totalStock === 0) { %>
                                            <span class="absolute top-2 left-2 bg-black text-white text-[10px] px-2 py-1 uppercase tracking-widest">Out of Stock</span>
                                        <% } %>
                                    </a>

                                    <!-- Wishlist Button -->
                                    <button type="button"
                                        class="wishlist-btn <%= inWishlist ? 'active' : '' %>"
                                        data-variant-id="<%= activeVariantId %>"
                                        data-default-variant-id="<%= p.defaultVariantId ? p.defaultVariantId.toString() : '' %>"
                                        data-in-wishlist="<%= inWishlist ? 'true' : 'false' %>"
                                        title="<%= inWishlist ? 'Remove from wishlist' : 'Save to wishlist' %>"
                                        aria-label="<%= inWishlist ? 'Remove from wishlist' : 'Save to wishlist' %>">
                                        <svg width="17" height="17" viewBox="0 0 24 24" 
                                             fill="<%= inWishlist ? '#ef4444' : 'none' %>" 
                                             stroke="<%= inWishlist ? '#ef4444' : 'currentColor' %>" 
                                             stroke-width="1.8">
                                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.6Z"/>
                                        </svg>
                                    </button>
                                </div>

                                <a href="/products/<%= p.slug %>" class="block">
                                    <p class="text-sm font-medium group-hover:text-gray-600 transition-colors"><%= p.name %></p>
                                    <p class="text-sm mt-1">&#8377;<%= p.displayPrice.toLocaleString('en-IN') %></p>
                                    <% if (p.totalReviews > 0) { %>
                                        <p class="text-xs text-gray-400 mt-0.5">&#9733; <%= p.averageRating.toFixed(1) %> (<%= p.totalReviews %>)</p>
                                    <% } %>
                                </a>
                            </div>
                        <% }) %>
                    </div>

                    <% if (totalPages > 1) { %>
                        <div class="flex justify-center gap-2 mt-12">
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <a href="<%= buildQuery({ page: i }) %>"
                                    class="w-9 h-9 flex items-center justify-center rounded-lg border text-sm <%= currentPage === i ? 'bg-black text-white border-black' : 'border-gray-200 text-black' %>">
                                    <%= i %>
                                </a>
                            <% } %>
                        </div>
                    <% } %>
                <% } %>
            </div>
        </div>
    </div>
</main>

<%- include("../partials/storeFooter") %>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const wishlistBtns = document.querySelectorAll('.wishlist-btn');

    wishlistBtns.forEach(btn => {
        btn.addEventListener('click', async function (e) {
            e.preventDefault();
            e.stopPropagation();

            const inWishlist = this.dataset.inWishlist === 'true';
            const variantId = inWishlist 
                ? this.dataset.variantId 
                : (this.dataset.defaultVariantId || this.dataset.variantId);

            if (!variantId) {
                if (typeof showToast === 'function') {
                    showToast('Product variant unavailable', 'warning');
                }
                return;
            }

            if (this.disabled) return;
            this.disabled = true;

            try {
                const endpoint = inWishlist 
                    ? `/wishlist/${variantId}/remove` 
                    : '/wishlist/add';
                
                const options = inWishlist
                    ? {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    }
                    : {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ variantId })
                    };

                const res = await fetch(endpoint, options);

                if (res.status === 401) {
                    window.location.href = '/login';
                    return;
                }

                const data = await res.json();
                if (data.requireLogin) {
                    window.location.href = '/login';
                    return;
                }

                if (data.success) {
                    const nowInWishlist = !inWishlist;
                    this.dataset.inWishlist = nowInWishlist ? 'true' : 'false';
                    
                    const svg = this.querySelector('svg');
                    if (nowInWishlist) {
                        this.classList.add('active');
                        this.dataset.variantId = variantId;
                        if (svg) {
                            svg.setAttribute('fill', '#ef4444');
                            svg.setAttribute('stroke', '#ef4444');
                        }
                        this.setAttribute('title', 'Remove from wishlist');
                        this.setAttribute('aria-label', 'Remove from wishlist');
                        if (typeof showToast === 'function') {
                            showToast('Added to wishlist', 'success');
                        }
                    } else {
                        this.classList.remove('active');
                        this.dataset.variantId = this.dataset.defaultVariantId || variantId;
                        if (svg) {
                            svg.setAttribute('fill', 'none');
                            svg.setAttribute('stroke', 'currentColor');
                        }
                        this.setAttribute('title', 'Save to wishlist');
                        this.setAttribute('aria-label', 'Save to wishlist');
                        if (typeof showToast === 'function') {
                            showToast('Removed from wishlist', 'info');
                        }
                    }

                    if (typeof updateNavWishlistCount === 'function' && data.wishlistCount !== undefined) {
                        updateNavWishlistCount(data.wishlistCount);
                    }
                } else {
                    if (typeof showToast === 'function') {
                        showToast(data.message || 'Unable to update wishlist', 'error');
                    }
                }
            } catch (err) {
                console.error('Wishlist error:', err);
                if (typeof showToast === 'function') {
                    showToast('Something went wrong. Please try again.', 'error');
                }
            } finally {
                this.disabled = false;
            }
        });
    });
});
</script>

</body>
</html>