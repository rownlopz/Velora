<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Wishlist | VELORA</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-[#FAFAF8] flex flex-col min-h-screen">

<%- include("../partials/storeHeader") %>

<main class="flex-1">
    <div class="max-w-screen-lg mx-auto px-6 md:px-10 py-10">

        <h1 class="text-3xl font-medium">My Wishlist</h1>
        <p id="wishlistCountText" class="text-gray-400 text-sm mt-1"><%= typeof totalItems !== 'undefined' ? totalItems : items.length %> item<%= (typeof totalItems !== 'undefined' ? totalItems : items.length) === 1 ? '' : 's' %></p>

        <% if (items.length === 0) { %>
            <div id="emptyWishlist" class="text-center py-24">
                <svg class="mx-auto mb-5 text-gray-300" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.6Z"/></svg>
                <p class="text-gray-400">Your wishlist is empty.</p>
                <a href="/products" class="inline-block mt-4 text-sm font-semibold underline">Browse Collections</a>
            </div>
        <% } else { %>
            <div id="wishlistGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 mt-8">
                <% items.forEach(item => { %>
                    <div class="wishlist-item bg-white border border-gray-100 rounded-xl overflow-hidden group relative flex flex-col"
                         data-variant-id="<%= item.variantId %>">

                        <!-- Remove button (AJAX) -->
                        <button type="button"
                            class="remove-wishlist-btn absolute top-3 right-3 z-10 w-8 h-8 flex items-center justify-center bg-white/80 backdrop-blur rounded-full text-gray-500 hover:text-red-500 hover:bg-white transition shadow-sm"
                            data-variant-id="<%= item.variantId %>"
                            title="Remove from wishlist">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
                        </button>

                        <!-- Product image -->
                        <a href="<%= item.product ? '/products/' + item.product.slug : '#' %>"
                           class="block aspect-[3/4] bg-gray-50 overflow-hidden relative">
                            <% if (item.product && item.product.thumbnail) { %>
                                <img src="<%= item.product.thumbnail %>" alt="<%= item.product.name %>"
                                     class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                            <% } %>

                            <% if (!item.isAvailable) { %>
                                <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
                                    <span class="bg-white text-black text-xs font-semibold px-3 py-1 uppercase tracking-widest rounded-full">Unavailable</span>
                                </div>
                            <% } else if (item.variant && item.variant.stock === 0) { %>
                                <div class="absolute top-2 left-2">
                                    <span class="bg-black text-white text-[10px] px-2 py-1 uppercase tracking-widest">Out of Stock</span>
                                </div>
                            <% } %>
                        </a>

                        <!-- Info & actions -->
                        <div class="p-4 flex flex-col flex-1">
                            <p class="font-medium text-sm">
                                <%= item.product ? item.product.name : 'Product unavailable' %>
                            </p>

                            <% if (item.variant) { %>
                                <p class="text-xs text-gray-400 mt-1">
                                    <%= [item.variant.color, item.variant.size].filter(Boolean).join(' / ') %>
                                </p>
                            <% } %>

                            <p class="text-sm mt-2 font-medium">
                                <% if (item.currentPrice) { %>
                                    &#8377;<%= item.currentPrice.toLocaleString('en-IN') %>
                                <% } else { %>
                                    &mdash;
                                <% } %>
                            </p>

                            <div class="mt-auto pt-4">
                                <% if (item.isAvailable && item.variant && item.variant.stock > 0) { %>
                                    <button type="button"
                                        class="move-to-cart-btn w-full h-10 bg-black text-white text-xs font-semibold uppercase tracking-widest rounded-lg hover:bg-gray-900 transition"
                                        data-variant-id="<%= item.variantId %>">
                                        Move to Cart
                                    </button>
                                <% } else { %>
                                    <span class="block w-full h-10 leading-10 text-center bg-gray-100 text-gray-400 text-xs font-semibold uppercase tracking-widest rounded-lg cursor-not-allowed">
                                        <%= !item.isAvailable ? 'Unavailable' : 'Out of Stock' %>
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Pagination -->
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <div class="flex justify-center items-center gap-2 mt-12">
                    <% if (currentPage > 1) { %>
                        <a href="/wishlist?page=<%= currentPage - 1 %>"
                           class="h-9 px-3 flex items-center justify-center rounded-xl text-xs font-medium bg-white border border-neutral-200 text-neutral-700 hover:border-neutral-400 hover:bg-neutral-50 transition shadow-xs"
                           title="Previous Page">
                            &larr; Prev
                        </a>
                    <% } %>

                    <% for (let p = 1; p <= totalPages; p++) { %>
                        <a href="/wishlist?page=<%= p %>"
                           class="w-9 h-9 flex items-center justify-center rounded-xl text-xs font-semibold transition shadow-xs <%= p === currentPage ? 'bg-black text-white' : 'bg-white border border-neutral-200 text-neutral-700 hover:border-neutral-400 hover:bg-neutral-50' %>">
                            <%= p %>
                        </a>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <a href="/wishlist?page=<%= currentPage + 1 %>"
                           class="h-9 px-3 flex items-center justify-center rounded-xl text-xs font-medium bg-white border border-neutral-200 text-neutral-700 hover:border-neutral-400 hover:bg-neutral-50 transition shadow-xs"
                           title="Next Page">
                            Next &rarr;
                        </a>
                    <% } %>
                </div>
            <% } %>

            <div class="mt-10 flex justify-between items-center border-t border-gray-100 pt-6">
                <a href="/products" class="text-sm text-gray-500 hover:text-black">&larr; Continue Shopping</a>
            </div>
        <% } %>

    </div>
</main>

<%- include("../partials/storeFooter") %>

<script>
(function () {
    // ---- Remove from wishlist ----
    document.addEventListener('click', async function (e) {
        const btn = e.target.closest('.remove-wishlist-btn');
        if (!btn) return;
        const variantId = btn.dataset.variantId;
        btn.disabled = true;

        try {
            const res = await fetch(`/wishlist/${variantId}/remove`, {
                method: 'POST',
                headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            });
            const data = await res.json();
            if (data.success) {
                const row = btn.closest('.wishlist-item');
                if (row) row.remove();
                if (typeof updateNavWishlistCount === 'function') updateNavWishlistCount(data.wishlistCount);

                const remaining = document.querySelectorAll('.wishlist-item');
                const countEl = document.getElementById('wishlistCountText');
                if (remaining.length === 0) {
                    const grid = document.getElementById('wishlistGrid');
                    if (grid) grid.remove();
                    document.querySelector('main .max-w-screen-lg').insertAdjacentHTML('beforeend', `
                        <div class="text-center py-24">
                            <p class="text-gray-400">Your wishlist is empty.</p>
                            <a href="/products" class="inline-block mt-4 text-sm font-semibold underline">Browse Collections</a>
                        </div>`);
                    if (countEl) countEl.textContent = '0 items';
                } else {
                    const n = remaining.length;
                    if (countEl) countEl.textContent = n + ' item' + (n === 1 ? '' : 's');
                }
                showToast('Removed from wishlist', 'info');
            } else {
                showToast('Unable to remove item', 'error');
                btn.disabled = false;
            }
        } catch (err) {
            showToast('Something went wrong', 'error');
            btn.disabled = false;
        }
    });

    // ---- Move to Cart from Wishlist ----
    document.addEventListener('click', async function (e) {
        const btn = e.target.closest('.move-to-cart-btn');
        if (!btn) return;
        const variantId = btn.dataset.variantId;
        const originalText = btn.textContent.trim();
        btn.disabled = true;
        btn.textContent = 'Adding...';

        try {
            const res = await fetch('/cart/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify({ variantId, quantity: 1 }),
            });

            if (res.status === 401) {
                window.location.href = '/login';
                return;
            }

            const data = await res.json();
            if (data.requireLogin) {
                window.location.href = '/login';
                return;
            }

            if (data.success) {
                // Remove from wishlist after moving to cart (backend does it too, but update UI)
                const row = btn.closest('.wishlist-item');
                if (row) row.remove();
                if (typeof updateNavCartCount === 'function') updateNavCartCount(data.cartCount);

                const remaining = document.querySelectorAll('.wishlist-item');
                const countEl = document.getElementById('wishlistCountText');
                const newWishlistCount = data.wishlistCount !== undefined ? data.wishlistCount : remaining.length;
                if (remaining.length === 0) {
                    const grid = document.getElementById('wishlistGrid');
                    if (grid) grid.remove();
                    document.querySelector('main .max-w-screen-lg').insertAdjacentHTML('beforeend', `
                        <div class="text-center py-24">
                            <p class="text-gray-400">Your wishlist is empty.</p>
                            <a href="/products" class="inline-block mt-4 text-sm font-semibold underline">Browse Collections</a>
                        </div>`);
                    if (countEl) countEl.textContent = '0 items';
                } else {
                    const n = remaining.length;
                    if (countEl) countEl.textContent = n + ' item' + (n === 1 ? '' : 's');
                }
                if (typeof updateNavWishlistCount === 'function') updateNavWishlistCount(newWishlistCount);

                showToast('Moved to cart', 'success');
            } else {
                showToast(data.message || 'Unable to add to cart', 'error');
                btn.disabled = false;
                btn.textContent = originalText;
            }
        } catch (err) {
            showToast('Something went wrong', 'error');
            btn.disabled = false;
            btn.textContent = originalText;
        }
    });
})();
</script>

</body>
</html>
