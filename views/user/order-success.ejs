<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Placed Successfully | VELORA</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-[#FAFAF8] flex flex-col min-h-screen">

<%- include("../partials/storeHeader", { active: "" }) %>

<main class="flex-1 flex items-center justify-center py-16 px-6">
    <div class="max-w-xl w-full bg-white border border-gray-200 rounded-3xl p-8 md:p-12 text-center shadow-sm">

        <!-- Minimalist Success Illustration -->
        <div class="w-20 h-20 mx-auto rounded-full bg-stone-100 flex items-center justify-center text-black mb-6 border border-stone-200">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5"/>
            </svg>
        </div>

        <span class="inline-block px-3 py-1 bg-stone-100 text-stone-800 text-[11px] font-semibold uppercase tracking-widest rounded-full mb-3">
            Cash on Delivery Confirmed
        </span>

        <h1 class="text-3xl font-medium text-gray-900 tracking-tight">
            Thank you for your order!
        </h1>

        <p class="text-gray-500 text-sm mt-3 leading-relaxed">
            Your order has been placed and is now being processed. Please keep the exact amount ready in cash upon delivery.
        </p>

        <!-- Order Snapshot Card -->
        <div class="bg-gray-50 border border-gray-100 rounded-2xl p-5 my-8 text-left space-y-3">
            <div class="flex justify-between items-center text-xs pb-3 border-b border-gray-200/60">
                <span class="text-gray-500 uppercase tracking-wider font-semibold">Order Number</span>
                <span class="font-mono font-bold text-gray-900 text-sm"><%= order.orderNumber %></span>
            </div>

            <div class="flex justify-between items-center text-xs pb-3 border-b border-gray-200/60">
                <span class="text-gray-500 uppercase tracking-wider font-semibold">Payment Mode</span>
                <span class="font-medium text-gray-900">Cash on Delivery (Pay upon arrival)</span>
            </div>

            <div class="flex justify-between items-center text-xs pb-3 border-b border-gray-200/60">
                <span class="text-gray-500 uppercase tracking-wider font-semibold">Deliver To</span>
                <span class="font-medium text-gray-900 text-right truncate max-w-[220px]">
                    <%= order.shippingAddress.firstName %> <%= order.shippingAddress.lastName %>, <%= order.shippingAddress.city %>
                </span>
            </div>

            <div class="flex justify-between items-center text-xs pt-1">
                <span class="text-gray-500 uppercase tracking-wider font-semibold">Amount to Pay</span>
                <span class="text-base font-bold text-gray-900">&#8377;<%= order.pricing.totalAmount.toLocaleString('en-IN') %></span>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/orders/<%= order._id %>"
                class="flex-1 py-4 px-6 bg-black text-white text-xs font-semibold uppercase tracking-widest rounded-xl hover:bg-gray-800 transition">
                View Order Details
            </a>
            <a href="/products"
                class="flex-1 py-4 px-6 border border-gray-300 text-gray-800 text-xs font-semibold uppercase tracking-widest rounded-xl hover:border-black hover:text-black transition">
                Continue Shopping
            </a>
        </div>

    </div>
</main>

<%- include("../partials/storeFooter") %>

</body>
</html>
