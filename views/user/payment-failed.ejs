<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Pending / Failed | VELORA</title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</head>
<body class="bg-[#FAFAF8] flex flex-col min-h-screen">

<%- include("../partials/storeHeader", { active: "" }) %>

<main class="flex-1 flex items-center justify-center py-16 px-6">
    <div class="max-w-xl w-full bg-white border border-gray-200 rounded-3xl p-8 md:p-12 text-center shadow-sm">

        <!-- Failure / Alert Illustration -->
        <div class="w-20 h-20 mx-auto rounded-full bg-rose-50 flex items-center justify-center text-rose-600 mb-6 border border-rose-200">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
        </div>

        <span class="inline-block px-3 py-1 bg-rose-100 text-rose-800 text-[11px] font-semibold uppercase tracking-widest rounded-full mb-3">
            Payment Incomplete
        </span>

        <h1 class="text-3xl font-medium text-gray-900 tracking-tight">
            Payment Not Completed
        </h1>

        <p class="text-gray-500 text-sm mt-3 leading-relaxed">
            <%= typeof errorMessage !== 'undefined' && errorMessage ? errorMessage : 'We could not complete your online transaction.' %>
            Your order is preserved and your items remain reserved. You can retry paying now without placing a new order.
        </p>

        <!-- Order Snapshot Card -->
        <div class="bg-gray-50 border border-gray-100 rounded-2xl p-5 my-8 text-left space-y-3">
            <div class="flex justify-between items-center text-xs pb-3 border-b border-gray-200/60">
                <span class="text-gray-500 uppercase tracking-wider font-semibold">Order Reference</span>
                <span class="font-mono font-bold text-gray-900 text-sm"><%= order.orderNumber %></span>
            </div>

            <div class="flex justify-between items-center text-xs pb-3 border-b border-gray-200/60">
                <span class="text-gray-500 uppercase tracking-wider font-semibold">Payment Status</span>
                <span class="font-semibold text-rose-600"><%= order.paymentStatus %></span>
            </div>

            <div class="flex justify-between items-center text-xs pt-1">
                <span class="text-gray-500 uppercase tracking-wider font-semibold">Payable Total</span>
                <span class="text-base font-bold text-gray-900">&#8377;<%= order.pricing.totalAmount.toLocaleString('en-IN') %></span>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <button type="button" id="retryPaymentBtn"
                class="flex-1 py-4 px-6 bg-black text-white text-xs font-semibold uppercase tracking-widest rounded-xl hover:bg-gray-800 transition flex items-center justify-center gap-2 cursor-pointer">
                <span>Retry Payment</span>
            </button>
            <a href="/orders/<%= order._id %>"
                class="flex-1 py-4 px-6 border border-gray-300 text-gray-800 text-xs font-semibold uppercase tracking-widest rounded-xl hover:border-black hover:text-black transition">
                View in Orders
            </a>
        </div>

        <div class="mt-4">
            <a href="/products" class="text-xs text-gray-500 hover:text-black underline transition">
                Return to Shopping
            </a>
        </div>

    </div>
</main>

<%- include("../partials/storeFooter") %>

<script>
(function () {
    const retryBtn = document.getElementById('retryPaymentBtn');
    if (!retryBtn) return;

    let isRetrying = false;

    function resetButton(btn, originalHtml) {
        isRetrying = false;
        btn.disabled = false;
        btn.innerHTML = originalHtml;
    }

    retryBtn.addEventListener('click', async function (e) {
        e.preventDefault();
        if (isRetrying || retryBtn.disabled) return;

        isRetrying = true;
        retryBtn.disabled = true;
        const originalText = retryBtn.innerHTML;
        retryBtn.innerHTML = '<span>Initiating Gateway...</span>';

        try {
            const res = await fetch('/orders/<%= order._id %>/retry-payment', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
            });

            let data;
            try {
                data = await res.json();
            } catch (jsonErr) {
                alert('Invalid response from server. Please try again.');
                resetButton(retryBtn, originalText);
                return;
            }

            if (data.isAlreadyPaid || (data.success && data.order && data.order.paymentStatus === 'COMPLETED')) {
                const targetUrl = data.redirectUrl || '/orders/<%= order._id %>/payment-success';
                window.location.href = targetUrl;
                return;
            }

            if (data.isCancelledLateRefund || (data.order && data.order.orderStatus === 'CANCELLED' && data.order.paymentStatus === 'REFUNDED')) {
                const targetUrl = data.redirectUrl || ('/orders/<%= order._id %>?notice=' + encodeURIComponent(data.message || 'This order was cancelled. Your payment has been refunded to your wallet.'));
                window.location.href = targetUrl;
                return;
            }

            if (!res.ok || !data.success || !data.razorpay) {
                alert(data.message || 'Unable to retry payment at this time.');
                resetButton(retryBtn, originalText);
                return;
            }

            if (!data.razorpay.keyId || !data.razorpay.orderId) {
                alert('Payment gateway configuration error. Please contact support.');
                resetButton(retryBtn, originalText);
                return;
            }

            const options = {
                key: data.razorpay.keyId,
                amount: data.razorpay.amount,
                currency: data.razorpay.currency,
                name: data.razorpay.name || 'Velora',
                description: data.razorpay.description || 'Retry Order Payment',
                order_id: data.razorpay.orderId,
                prefill: data.razorpay.prefill || {},
                theme: { color: '#000000' },
                handler: async function (response) {
                    try {
                        retryBtn.innerHTML = '<span>Verifying Payment...</span>';
                        const verifyRes = await fetch('/checkout/verify-razorpay', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest',
                            },
                            body: JSON.stringify({
                                orderId: '<%= order._id %>',
                                razorpayOrderId: response.razorpay_order_id,
                                razorpayPaymentId: response.razorpay_payment_id,
                                razorpaySignature: response.razorpay_signature,
                            }),
                        });

                        const verifyData = await verifyRes.json();
                        if (verifyData.redirectUrl) {
                            window.location.href = verifyData.redirectUrl;
                        } else {
                            window.location.href = '/orders/<%= order._id %>/payment-success';
                        }
                    } catch (err) {
                        console.error('Verification error:', err);
                        window.location.reload();
                    }
                },
                modal: {
                    ondismiss: function () {
                        resetButton(retryBtn, originalText);
                    },
                },
            };

            const rzp = new Razorpay(options);
            rzp.on('payment.failed', function (resp) {
                const desc = resp.error ? resp.error.description : 'Payment retry failed';
                alert('Payment failed: ' + desc);
                resetButton(retryBtn, originalText);
            });
            rzp.open();
        } catch (err) {
            console.error('Retry error:', err);
            alert('Something went wrong. Please check your network and try again.');
            resetButton(retryBtn, originalText);
        }
    });
})();
</script>

</body>
</html>
