<%- include("../partials/authHeader",{title:"Login"}) %>

<main class="flex-1 flex items-center justify-center py-16">

    <div class="w-full max-w-md bg-white border border-gray-200 rounded-2xl shadow-sm p-10">

        <h2 class="text-5xl font-medium text-center">
            Welcome Back
        </h2>

        <p class="text-center text-gray-500 mt-5 leading-7">
            Please enter your credentials to access your account.
        </p>

        <% if (typeof errors !== 'undefined' && errors.general) { %>
            <div class="mt-6 p-4 bg-red-50 border border-red-200 text-red-600 rounded-xl text-sm text-center">
                <%= errors.general %>
            </div>
        <% } %>

        <form action="/login" method="POST" class="mt-10 space-y-6">
            <div>
                <label class="block text-xs font-semibold uppercase tracking-widest mb-2">
                    Email Address
                </label>

                <input
                    type="email"
                    name="email"
                    value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                    class="w-full h-14 border border-gray-300 rounded-xl px-4 outline-none focus:border-black">
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase tracking-widest mb-2">
                    Password
                </label>
                <div class="relative">
                    <input
                        type="password"
                        name="password"
                        class="w-full h-14 border border-gray-300 rounded-xl px-4 pr-12 outline-none focus:border-black">
                    <button
                        type="button"
                        class="absolute right-4 top-1/2 -translate-y-1/2">
                        👁
                    </button>
                </div>
            </div>

            <div class="flex justify-between items-center text-sm">
                <label class="flex items-center gap-2">
                    <input type="checkbox">
                    Remember me
                </label>
                <a
                    href="/forgot-password"
                    class="font-medium">

                    Forgot Password?
                </a>
            </div>

            <button
                class="w-full h-14 bg-black text-white rounded-xl font-semibold hover:bg-gray-900 transition">

                LOGIN

            </button>

        </form>

        <div class="flex items-center my-8">
            <div class="flex-1 h-px bg-gray-300"></div>
            <span class="mx-4 text-gray-400 text-sm">
                OR
            </span>

            <div class="flex-1 h-px bg-gray-300"></div>
        </div>

        <div class="grid grid-cols-1 gap-4">
            <a
                href="/auth/google"
                class="h-14 border rounded-xl hover:bg-gray-50 flex items-center justify-center">
                Continue with Google
            </a>

            <!-- <button
                class="h-14 border rounded-xl hover:bg-gray-50">
                Apple
            </button> -->
        </div>

        <p class="text-center mt-10 text-gray-500">
            Don't have an account?
            <a
                href="/signup"
                class="font-semibold text-black">
                Sign up
            </a>
        </p>
    </div>
</main>

<%- include("../partials/authFooter") %>