<%- include("../partials/authHeader", { title: "Change Password" }) %>

<main class="flex-1 flex items-center justify-center py-16 px-4">
    <div class="auth-card">

        <h2 class="text-4xl font-medium text-center">
            Change Password
        </h2>

        <% if (typeof errors !== 'undefined' && errors.general) { %>
            <div class="mt-6 p-4 bg-red-50 border border-red-200 text-red-600 rounded-xl text-sm text-center">
                <%= errors.general %>
            </div>
        <% } %>

        <form action="/profile/change-password" method="POST" class="mt-8 space-y-6">

            <div>
                <label class="auth-label">Current Password</label>
                <input type="password" name="currentPassword" class="auth-input">
                <% if (errors.currentPassword) { %>
                    <p class="text-red-600 text-sm mt-1"><%= errors.currentPassword %></p>
                <% } %>
            </div>

            <div>
                <label class="auth-label">New Password</label>
                <input type="password" name="newPassword" class="auth-input">
                <% if (errors.newPassword) { %>
                    <p class="text-red-600 text-sm mt-1"><%= errors.newPassword %></p>
                <% } %>
            </div>

            <div>
                <label class="auth-label">Confirm New Password</label>
                <input type="password" name="confirmNewPassword" class="auth-input">
                <% if (errors.confirmNewPassword) { %>
                    <p class="text-red-600 text-sm mt-1"><%= errors.confirmNewPassword %></p>
                <% } %>
            </div>

            <button type="submit" class="primary-btn">
                UPDATE PASSWORD
            </button>
        </form>

        <a href="/profile" class="block text-center mt-6 text-sm text-gray-500 hover:text-black transition">
            Cancel
        </a>
    </div>
</main>

<%- include("../partials/authFooter") %>
