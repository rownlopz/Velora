<%- include("../partials/authHeader", { title: "Change Email" }) %>

<main class="flex-1 flex items-center justify-center py-16 px-4">
    <div class="auth-card">

        <h2 class="text-4xl font-medium text-center">
            Change Email
        </h2>

        <% if (typeof errors !== 'undefined' && errors.general) { %>
            <div class="mt-6 p-4 bg-red-50 border border-red-200 text-red-600 rounded-xl text-sm text-center">
                <%= errors.general %>
            </div>
        <% } %>

        <% if (step === "request") { %>
            <p class="text-center text-gray-500 mt-4 leading-7">
                Enter your new email address. We'll send a verification code to confirm it.
            </p>

            <form action="/profile/change-email" method="POST" class="mt-8 space-y-6">
                <div>
                    <label class="auth-label">New Email Address</label>
                    <input type="email" name="newEmail" class="auth-input">
                    <% if (errors.newEmail) { %>
                        <p class="text-red-600 text-sm mt-1"><%= errors.newEmail %></p>
                    <% } %>
                </div>

                <button type="submit" class="primary-btn">
                    SEND VERIFICATION CODE
                </button>
            </form>
        <% } else { %>
            <p class="text-center text-gray-500 mt-4 leading-7">
                We've sent a code to
                <br>
                <span class="font-medium text-black"><%= newEmail %></span>
            </p>

            <form action="/profile/change-email/verify" method="POST" class="mt-8 space-y-6">
                <div>
                    <label class="auth-label">Verification Code</label>
                    <input type="text" name="otp" maxlength="4" inputmode="numeric" class="auth-input text-center tracking-[0.5em]">
                    <% if (errors.otp) { %><p class="text-red-600 text-sm mt-1"><%= errors.otp %></p><% } %>
                </div>

                <div class="flex items-center justify-between mt-2">
                    <p class="text-xs text-gray-500">Didn't receive the code?</p>
                    <button type="button" id="resendBtn" disabled class="text-xs font-semibold text-black disabled:text-gray-400 cursor-not-allowed transition">
                        Resend in <span id="timer">60</span>s
                    </button>
                </div>

                <button type="submit" class="primary-btn">
                    CONFIRM EMAIL CHANGE
                </button>
            </form>
        <% } %>

        <a href="/profile" class="block text-center mt-6 text-sm text-gray-500 hover:text-black transition">
            Cancel
        </a>
    </div>
</main>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const resendBtn = document.getElementById("resendBtn");
        const timerSpan = document.getElementById("timer");

        if (resendBtn && timerSpan) {
            let timeLeft = 60;
            const timerId = setInterval(() => {
                timeLeft--;
                if (timeLeft <= 0) {
                    clearInterval(timerId);
                    resendBtn.disabled = false;
                    resendBtn.innerHTML = "Resend OTP";
                    resendBtn.classList.remove("cursor-not-allowed", "text-gray-400");
                } else {
                    timerSpan.textContent = timeLeft;
                }
            }, 1000);

            resendBtn.addEventListener("click", async () => {
                if (resendBtn.disabled) return;
                
                resendBtn.disabled = true;
                resendBtn.innerHTML = "Sending...";
                resendBtn.classList.add("cursor-not-allowed", "text-gray-400");

                try {
                    const response = await fetch("/profile/change-email/resend-otp", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" }
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        window.location.reload();
                    } else {
                        showInlineToast(data.message || "Failed to resend OTP", "error");
                        resendBtn.disabled = false;
                        resendBtn.innerHTML = "Resend OTP";
                        resendBtn.classList.remove("cursor-not-allowed", "text-gray-400");
                    }
                } catch (err) {
                    showInlineToast("Something went wrong. Please try again.", "error");
                    resendBtn.disabled = false;
                    resendBtn.innerHTML = "Resend OTP";
                    resendBtn.classList.remove("cursor-not-allowed", "text-gray-400");
                }
            });
        }
    });
</script>

<%- include("../partials/authFooter") %>

<div id="inlineToastContainer" style="position:fixed;top:1.25rem;right:1.25rem;z-index:9999;"></div>
<script>
function showInlineToast(message, type) {
    var container = document.getElementById('inlineToastContainer');
    var bg = type === 'error' ? '#dc2626' : type === 'success' ? '#000' : '#2563eb';
    var el = document.createElement('div');
    el.style.cssText = 'background:' + bg + ';color:#fff;padding:12px 18px;border-radius:10px;font-size:13px;margin-bottom:8px;box-shadow:0 4px 24px rgba(0,0,0,0.18);max-width:320px;font-family:inherit;';
    el.textContent = message;
    container.appendChild(el);
    setTimeout(function() { el.remove(); }, 4000);
}
</script>
